---
import type { GetStaticPaths } from 'astro';
import CasePage from '../../../components/CasePage.astro';
import { caseSlugs, getCase, getPortfolio } from '../../../data/portfolio.data';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => caseSlugs.map((slug) => ({ params: { slug }, props: { slug } }))) satisfies GetStaticPaths;
const { slug } = Astro.props as { slug: string };
const content = getPortfolio('en');
const project = getCase('en', slug)!;
const alternatePath = `/proyectos/${slug}`;
---
<BaseLayout locale="en" title={`${project.title} | ${content.profile.name}`} description={project.summary} ogImage={`/og/en-${slug}.png`} alternatePath={alternatePath}>
  <CasePage content={content} project={project} alternatePath={alternatePath} />
</BaseLayout>
