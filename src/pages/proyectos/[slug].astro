---
import type { GetStaticPaths } from 'astro';
import CasePage from '../../components/CasePage.astro';
import { caseSlugs, getCase, getPortfolio } from '../../data/portfolio.data';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => caseSlugs.map((slug) => ({ params: { slug }, props: { slug } }))) satisfies GetStaticPaths;
const { slug } = Astro.props as { slug: string };
const content = getPortfolio('es');
const project = getCase('es', slug)!;
const alternatePath = `/en/projects/${slug}`;
---
<BaseLayout locale="es" title={`${project.title} | ${content.profile.name}`} description={project.summary} ogImage={`/og/es-${slug}.png`} alternatePath={alternatePath}>
  <CasePage content={content} project={project} alternatePath={alternatePath} />
</BaseLayout>
