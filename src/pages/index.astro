---
import "@fontsource-variable/ibm-plex-sans";
import { experience, links, profile, projects, type Project } from "../data/portfolio.data";
import {
  siAstro,
  siDocker,
  siGithubactions,
  siGo,
  siNestjs,
  siNextdotjs,
  siNodedotjs,
  siOpenapiinitiative,
  siOpentelemetry,
  siPostgresql,
  siReact,
  siRedis,
  siSequelize,
  siTypeorm,
  siTypescript,
} from "simple-icons";

const projectById = (id: string) => projects.find((project) => project.id === id) as Project;
const primaryProjects = [projectById("el-editor-cms"), projectById("elementos"), projectById("minecall")];
const secondaryProjects = [projectById("chichitos-ecommerce"), projectById("chemical-software")];
const memoriesAI = projectById("memoriesai");

const projectContext: Record<string, string> = {
  "el-editor-cms": "CMS privado + 2 portales públicos",
  elementos: "Marketplace B2B/B2C",
  minecall: "Producto realtime",
};

const projectDomains: Record<string, string[]> = {
  "el-editor-cms": ["eleditorplatense.com", "eleditormendoza.com.ar"],
  elementos: ["portaltest.elementosconstruccion.com.ar"],
  minecall: ["minecall.online"],
};

const harnessSteps = [
  ["Contexto", "Recupera decisiones confirmadas del proyecto."],
  ["Recorrido", "Activa reglas y herramientas según el trabajo."],
  ["Ejecución", "Modifica el producto en su repositorio real."],
  ["Evidencia", "Prueba el comportamiento afectado antes de cerrar."],
  ["Memoria", "Conserva sólo lo que será útil en otra sesión."],
];

const technologyGroups = [
  { title: "Backend", items: [siNodedotjs, siNestjs, siGo, siOpenapiinitiative] },
  { title: "Datos", items: [siPostgresql, siRedis, siSequelize, siTypeorm] },
  { title: "Frontend", items: [siTypescript, siReact, siNextdotjs, siAstro] },
  { title: "Calidad y operación", items: [siGithubactions, siDocker, siOpentelemetry] },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio profesional de Ezequiel Pacheco, Full Stack Developer con foco en backend." />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ezequiel Pacheco · Full Stack Developer</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <a class="name" href="#inicio">Ezequiel Pacheco</a>
      <nav aria-label="Navegación principal">
        <a href="#productos">Productos</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#memoriesai">MemoriesAI</a>
      </nav>
      <a class="header-cta" href={profile.cvPath} download>Descargar CV</a>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero">
        <div class="hero-copy">
          <h1>Full Stack Developer<span>con foco en backend.</span></h1>
          <p>{profile.heroDescription}</p>
          <div class="hero-actions">
            <a class="button primary" href="#productos">Ver productos en producción</a>
            <a class="button secondary" href={links.linkedin.href} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <aside class="hero-summary" aria-label="Resumen profesional">
          <dl>
            <div><dt>Actualmente</dt><dd>{profile.currentCompany}</dd></div>
            <div><dt>Especialidad</dt><dd>Backend, datos y producto</dd></div>
            <div><dt>Ubicación</dt><dd>{profile.location}</dd></div>
          </dl>
          <a href={links.email.href} target="_blank" rel="noreferrer">{profile.email}</a>
        </aside>
      </section>

      <section id="productos" class="products" aria-labelledby="products-title">
        <header class="section-heading" data-reveal>
          <h2 id="products-title">Productos reales que podés abrir.</h2>
          <p>Trabajo sobre backend, datos, interfaces y operación. Estas URLs muestran el resultado funcionando; debajo explico qué construí en cada sistema.</p>
        </header>

        <div class="product-nav" role="tablist" aria-label="Elegir producto">
          {primaryProjects.map((project, index) => (
            <button class:list={[index === 0 && "is-active"]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-product-jump={index}>{project.title}</button>
          ))}
        </div>
        <div class="product-carousel" data-reveal>
          <div class="product-list">
            {primaryProjects.map((project, index) => (
              <article class="product" role="tabpanel" aria-label={project.title} data-product-card={index}>
              <div class="product-main">
                <div class="product-title">
                  <h3>{project.title}</h3>
                  <span>{projectContext[project.id]}</span>
                </div>
                <p class="product-summary">{project.summary}</p>
                <p class="product-role"><strong>Mi trabajo:</strong> {project.responsibility}</p>
              </div>
              <div class="product-proof">
                <ul aria-label={`Capacidades demostradas en ${project.title}`}>
                  {project.evidence.slice(0, 4).map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div class="product-links">
                {project.links.map((link, index) => (
                  <a class:list={["live-link", index > 0 && "live-link-secondary"]} href={link.href} target="_blank" rel="noreferrer">
                    <span><i aria-hidden="true"></i>{projectDomains[project.id]?.[index] ?? link.label}</span>
                    <strong>{link.label} <span aria-hidden="true">↗</span></strong>
                  </a>
                ))}
                {project.id === "el-editor-cms" && <small>El CMS está en producción y es privado. Los portales públicos muestran su salida editorial.</small>}
              </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="more-products" aria-labelledby="more-products-title" data-reveal>
        <header>
          <h2 id="more-products-title">También construí.</h2>
          <p>Otros productos que amplían el recorrido técnico.</p>
        </header>
        <div class="more-list">
          {secondaryProjects.map((project) => (
            <article>
              <div><h3>{project.title}</h3><p>{project.summary}</p></div>
              {project.links[0] && (
                <a href={project.links[0].href} target="_blank" rel="noreferrer">{project.links[0].label} <span aria-hidden="true">↗</span></a>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="technologies" aria-labelledby="technologies-title" data-reveal>
        <header>
          <h2 id="technologies-title">Tecnologías que uso.</h2>
          <p>Elijo el stack según el producto. Estas son las herramientas que aparecen de forma consistente en mi trabajo.</p>
        </header>
        <div class="technology-grid">
          {technologyGroups.map((group) => (
            <article>
              <h3>{group.title}</h3>
              <div class="technology-items">
                {group.items.map((technology) => (
                  <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={technology.path}></path></svg>{technology.title}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="memoriesai" class="memories" aria-labelledby="memories-title">
        <div class="memories-copy" data-reveal>
          <h2 id="memories-title"><strong>MemoriesAI.</strong><span>Contexto, ejecución y evidencia.</span></h2>
          <div>
            <p>{memoriesAI.summary} Diseñé el modelo de memoria, el CLI, las reglas de ejecución y las verificaciones que conectan una conversación con cambios comprobables en el producto.</p>
            <a href={links.email.href} target="_blank" rel="noreferrer">Pedir una explicación técnica <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="harness" data-reveal aria-label="Recorrido de trabajo de MemoriesAI">
          {harnessSteps.map(([title, description]) => (
            <div class="harness-step">
              <div><strong>{title}</strong><p>{description}</p></div>
            </div>
          ))}
        </div>
      </section>

      <section id="experiencia" class="experience" aria-labelledby="experience-title">
        <header class="section-heading" data-reveal>
          <h2 id="experience-title">Experiencia.</h2>
          <p>El portfolio complementa el CV: muestra productos; esta sección ubica el recorrido profesional.</p>
        </header>
        <div class="experience-list">
          {experience.map((item) => (
            <article data-reveal>
              <p>{item.date}</p>
              <div><h3>{item.company}</h3><strong>{item.role}</strong></div>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="contact" aria-labelledby="contact-title" data-reveal>
        <div><h2 id="contact-title">¿Querés hablar de producto o ingeniería?</h2><p>Estoy disponible para conversar sobre backend, full stack y construcción de productos web.</p></div>
        <div class="contact-links">
          <a class="button light" href={links.email.href} target="_blank" rel="noreferrer">Hablemos</a>
          <a href={links.github.href} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={links.linkedin.href} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </section>
    </main>

    <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.location}</span></footer>

    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll("[data-reveal]");
      if (reducedMotion) {
        reveals.forEach((element) => element.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -4%" });
        reveals.forEach((element) => observer.observe(element));
      }

      const productList = document.querySelector<HTMLElement>(".product-list");
      const productCards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
      const productButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-product-jump]"));
      const setActiveProduct = (index: number) => {
        productButtons.forEach((button, buttonIndex) => {
          button.classList.toggle("is-active", buttonIndex === index);
          button.setAttribute("aria-selected", buttonIndex === index ? "true" : "false");
        });
      };
      productButtons.forEach((button, index) => button.addEventListener("click", () => {
        const card = productCards[index];
        if (!productList || !card) return;
        productList.scrollTo({ left: card.offsetLeft - productList.offsetLeft, behavior: reducedMotion ? "auto" : "smooth" });
        setActiveProduct(index);
      }));
      let productFrame = 0;
      productList?.addEventListener("scroll", () => {
        window.cancelAnimationFrame(productFrame);
        productFrame = window.requestAnimationFrame(() => {
          const activeIndex = productCards.reduce((nearest, card, index) => {
            const currentDistance = Math.abs(card.offsetLeft - productList.offsetLeft - productList.scrollLeft);
            const nearestCard = productCards[nearest];
            const nearestDistance = Math.abs(nearestCard.offsetLeft - productList.offsetLeft - productList.scrollLeft);
            return currentDistance < nearestDistance ? index : nearest;
          }, 0);
          setActiveProduct(activeIndex);
        });
      }, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --paper-light: #ffffff;
    --surface: #f4f4f1;
    --ink: #1e1e1b;
    --muted: #62645f;
    --line: #deded8;
    --accent: #d8ad38;
    --accent-deep: #9f7416;
    --night: #24241f;
    --font: "IBM Plex Sans Variable", "IBM Plex Sans", Arial, sans-serif;
    --page: 1180px;
    --gutter: clamp(20px, 4vw, 56px);
    --ease: cubic-bezier(.16, 1, .3, 1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--paper); }
  body { min-width: 320px; margin: 0; color: var(--ink); background: var(--paper); font-family: var(--font); font-size: 16px; line-height: 1.55; text-rendering: optimizeLegibility; }
  h1, h2, h3, p, dl, dd, ul { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--accent-deep); outline-offset: 4px; }
  .skip-link { position: fixed; top: 10px; left: 10px; z-index: 100; padding: 10px 14px; color: var(--paper); background: var(--night); transform: translateY(-180%); }
  .skip-link:focus { transform: none; }
  .site-header, .hero, .products, .more-products, .technologies, .experience, footer { width: min(calc(100% - (var(--gutter) * 2)), var(--page)); margin-inline: auto; }

  .site-header { min-height: 70px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 32px; align-items: center; }
  .name { width: fit-content; font-weight: 700; letter-spacing: -.02em; }
  .site-header nav { display: flex; gap: 28px; color: var(--muted); font-size: .84rem; }
  .site-header nav a, .header-cta { transition: color 180ms ease, transform 260ms var(--ease); }
  .site-header nav a:hover, .header-cta:hover { transform: translateY(-2px); }
  .site-header nav a:hover, .header-cta:hover { color: var(--accent-deep); }
  .header-cta { justify-self: end; color: var(--accent-deep); font-size: .84rem; font-weight: 650; }

  .hero { min-height: 500px; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(290px, .65fr); gap: clamp(48px, 8vw, 110px); align-items: center; padding-block: 54px; }
  .hero-copy { animation: hero-in 750ms var(--ease) both; }
  .hero h1 { max-width: 800px; font-size: clamp(3.2rem, 5.4vw, 5.1rem); font-weight: 640; letter-spacing: -.05em; line-height: .97; }
  .hero h1 span { display: block; color: var(--muted); font-weight: 430; }
  .hero-copy > p { max-width: 700px; margin-top: 24px; color: var(--muted); font-size: clamp(1rem, 1.3vw, 1.15rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .button { min-height: 46px; display: inline-flex; gap: 9px; align-items: center; justify-content: center; padding: 0 18px; border-radius: 8px; font-size: .84rem; font-weight: 650; transition: transform 250ms var(--ease), background-color 180ms ease, border-color 180ms ease; }
  .button:hover { transform: translateY(-2px); }
  .button.primary { color: var(--ink); background: var(--accent); }
  .button.primary:hover { color: var(--paper); background: var(--accent-deep); }
  .button.secondary { background: var(--surface); }
  .hero-summary { padding: 28px; border-radius: 14px; background: var(--surface); animation: hero-in 750ms 100ms var(--ease) both; }
  .hero-summary dl { display: grid; gap: 20px; }
  .hero-summary dl div { display: grid; gap: 3px; }
  .hero-summary dt { color: var(--muted); font-size: .76rem; }
  .hero-summary dd { font-size: .95rem; font-weight: 620; }
  .hero-summary > a { display: block; margin-top: 26px; color: var(--accent-deep); font-size: .78rem; overflow-wrap: anywhere; }

  .products { padding-block: 58px 48px; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .55fr); gap: 42px; align-items: end; margin-bottom: 32px; }
  .section-heading h2 { font-size: clamp(2.2rem, 3.7vw, 3.6rem); font-weight: 560; letter-spacing: -.04em; line-height: 1.03; }
  .section-heading > p { color: var(--muted); font-size: .95rem; }
  .product-nav { display: flex; gap: 8px; margin-bottom: 16px; }
  .product-nav button { min-height: 40px; padding: 0 14px; border: 0; border-radius: 9px; color: var(--muted); background: transparent; cursor: pointer; font: inherit; font-size: .8rem; font-weight: 600; transition: color 220ms ease, background-color 220ms ease, transform 280ms var(--ease); }
  .product-nav button:hover { color: var(--ink); background: var(--surface); transform: translateY(-2px); }
  .product-nav button.is-active { color: var(--ink); background: var(--accent); }
  .product-carousel { overflow: hidden; }
  .product-list { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .product-list::-webkit-scrollbar { display: none; }
  .product { flex: 0 0 100%; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(230px, .55fr) minmax(250px, .56fr); gap: 34px; padding: clamp(26px, 3.5vw, 42px); border-radius: 16px; background: var(--surface); scroll-snap-align: start; transition: box-shadow 350ms var(--ease), transform 350ms var(--ease); }
  .product:hover { box-shadow: 0 18px 55px rgba(56, 46, 27, .1); transform: translateY(-3px); }
  .product-title { display: grid; gap: 7px; }
  .product-title h3 { font-size: clamp(1.65rem, 2.5vw, 2.3rem); font-weight: 650; letter-spacing: -.03em; line-height: 1; }
  .product-title span { color: var(--muted); font-size: .74rem; }
  .product-summary { max-width: 680px; margin-top: 18px; color: var(--muted); font-size: .94rem; }
  .product-role { max-width: 720px; margin-top: 17px; font-size: .82rem; }
  .product-role strong { font-weight: 650; }
  .product-proof { align-self: start; }
  .product-proof ul { display: grid; gap: 8px; padding: 0; list-style: none; font-size: .8rem; }
  .product-proof li { position: relative; padding-left: 15px; }
  .product-proof li::before { content: ""; position: absolute; top: .68em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent-deep); }
  .product-links { display: grid; align-content: start; gap: 9px; }
  .live-link { display: grid; gap: 8px; padding: 15px 16px; border-radius: 10px; color: var(--paper); background: var(--night); transition: background-color 180ms ease, transform 220ms var(--ease); }
  .live-link:hover { background: var(--accent-deep); transform: translateX(3px); }
  .live-link-secondary { color: var(--ink); background: var(--paper); }
  .live-link-secondary:hover { color: var(--paper); background: var(--night); }
  .live-link > span { display: flex; gap: 8px; align-items: center; font-size: .66rem; opacity: .76; overflow-wrap: anywhere; }
  .live-link i { flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: #48c57b; box-shadow: 0 0 0 3px rgba(72, 197, 123, .15); }
  .live-link strong { font-size: .78rem; font-weight: 620; }
  .live-link strong span { display: inline-block; transition: transform 260ms var(--ease); }
  .live-link:hover strong span { transform: translate(3px, -2px); }
  .product-links small { margin-top: 3px; color: var(--muted); font-size: .66rem; line-height: 1.45; }

  .more-products { padding-block: 42px 62px; }
  .more-products > header { display: flex; justify-content: space-between; gap: 30px; align-items: end; margin-bottom: 24px; }
  .more-products h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 560; letter-spacing: -.035em; }
  .more-products > header p { color: var(--muted); font-size: .9rem; }
  .more-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .more-list article { min-height: 150px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 30px; align-items: center; padding: 24px; border-radius: 12px; background: var(--surface); transition: transform 300ms var(--ease), background-color 220ms ease; }
  .more-list article:hover { background: #eee5cb; transform: translateY(-4px); }
  .more-list h3 { font-size: 1.4rem; font-weight: 640; }
  .more-list article > div p { max-width: 660px; margin-top: 7px; color: var(--muted); font-size: .78rem; }
  .more-list a { color: var(--accent-deep); font-size: .78rem; font-weight: 620; transition: transform 240ms var(--ease); }
  .more-list a:hover { transform: translateX(4px); }

  .technologies { padding-block: 18px 64px; }
  .technologies > header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .55fr); gap: 42px; align-items: end; margin-bottom: 28px; }
  .technologies > header p { color: var(--muted); font-size: .9rem; }
  .technologies h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); font-weight: 560; letter-spacing: -.04em; line-height: 1.03; }
  .technology-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .technology-grid article { min-height: 140px; padding: 24px; border-radius: 12px; background: var(--surface); transition: background-color 260ms ease, color 260ms ease, transform 320ms var(--ease); }
  .technology-grid article:hover { transform: translateY(-5px); }
  .technology-grid article:hover { color: var(--paper); background: var(--night); }
  .technology-grid h3 { font-size: .92rem; font-weight: 650; }
  .technology-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 12px; margin-top: 20px; }
  .technology-items > span { min-width: 0; display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: .7rem; transition: color 260ms ease, transform 280ms var(--ease); }
  .technology-items svg { flex: 0 0 auto; width: 18px; height: 18px; fill: currentColor; }
  .technology-grid article:hover .technology-items > span { color: #ddd4c2; }
  .technology-grid article:hover .technology-items > span:hover { color: #efc451; transform: translateX(3px); }

  .memories { padding: 64px max(var(--gutter), calc((100vw - var(--page)) / 2)); color: var(--paper); background: var(--night); }
  .memories-copy { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .55fr); gap: clamp(48px, 8vw, 110px); align-items: end; }
  .memories h2 { max-width: 15ch; font-size: clamp(2.7rem, 4.4vw, 4.25rem); font-weight: 440; letter-spacing: -.04em; line-height: 1; }
  .memories h2 strong, .memories h2 span { display: block; }
  .memories h2 strong { font-weight: 650; }
  .memories h2 span { margin-top: 6px; color: #d1c8b7; font-weight: 430; }
  .memories-copy > div p { max-width: 560px; color: #c9c0ad; font-size: .92rem; }
  .memories-copy > div a { display: inline-block; margin-top: 25px; color: #efc451; font-size: .8rem; font-weight: 620; }
  .harness { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; margin-top: 40px; }
  .harness-step { min-height: 160px; display: grid; align-content: center; padding: 26px; border-radius: 12px; background: rgba(255, 255, 255, .045); transition: background-color 260ms ease, transform 340ms var(--ease); }
  .harness-step:hover { background: rgba(239, 196, 81, .12); transform: translateY(-5px); }
  .harness-step strong { font-size: .84rem; font-weight: 620; }
  .harness-step p { margin-top: 8px; color: #bdb4a2; font-size: .74rem; }

  .experience { padding-block: 62px; }
  .experience-list { display: grid; gap: 10px; }
  .experience-list article { min-height: 130px; display: grid; grid-template-columns: minmax(150px, .32fr) minmax(230px, .5fr) minmax(0, 1fr); gap: 32px; align-items: center; padding: 24px; border-radius: 12px; background: var(--surface); transition: transform 300ms var(--ease), background-color 220ms ease; }
