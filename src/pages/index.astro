---
import "@fontsource-variable/ibm-plex-sans";
import { capabilities, experience, links, metadata, profile, projects, type Project } from "../data/portfolio.data";

const projectById = (id: string) => projects.find((project) => project.id === id) as Project;
const elementos = projectById("elementos");
const editor = projectById("el-editor-cms");
const minecall = projectById("minecall");
const cercaya = projectById("cercaya");
const chemical = projectById("chemical-software");
const memories = projectById("memoriesai");
const otherProjects = projects.filter((project) => ![elementos.id, editor.id, minecall.id, cercaya.id, chemical.id, memories.id].includes(project.id));
const personSchema = {
  "@context": "https://schema.org", "@type": "Person", name: profile.name, url: "https://portfolio-eze-pacheco.vercel.app/",
  jobTitle: profile.role, email: profile.email,
  address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
  sameAs: [links.linkedin.href, links.github.href],
  knowsAbout: ["Node.js", "TypeScript", "PostgreSQL", "NestJS", "Express", "Go", "Java", "Spring Boot", "React", "Next.js", "Software architecture", "Web application security"],
};
const externalProps = (external?: boolean) => external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metadata.description} />
    <meta name="keywords" content="Backend Developer, Full Stack Developer, Node.js, TypeScript, PostgreSQL, NestJS, Go, Java, Spring Boot, React, Next.js" />
    <meta name="theme-color" content="#111214" /><meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://portfolio-eze-pacheco.vercel.app/" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="es_AR" /><meta property="og:url" content="https://portfolio-eze-pacheco.vercel.app/" />
    <meta property="og:title" content={metadata.title} /><meta property="og:description" content={metadata.description} />
    <meta property="og:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" /><meta property="og:image:alt" content="Portfolio profesional de Ezequiel Pacheco" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} /><meta name="twitter:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script><title>{metadata.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">EZEQUIEL<br />PACHECO</a>
      <nav aria-label="Navegación principal"><a href="#proyectos">Work</a><a href="#experiencia">Experience</a><a href="#stack">Stack</a><a href={profile.cvPath} download>CV ↗</a><a href="#contacto">Contact</a></nav>
      <p class="header-status"><span aria-hidden="true"></span> Buenos Aires / Remote LATAM</p>
    </header>
    <main id="contenido">
      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-topline"><p>Portfolio / 2026</p><p>Backend-first systems</p></div>
        <div class="hero-title"><p class="hero-name">Ezequiel Pacheco</p><h1 id="hero-title">Backend<br /><em>Developer</em></h1></div>
        <div class="hero-lower">
          <p class="hero-scope">Full Stack Developer<br /><span>Producto · Sistemas · Operación</span></p>
          <div class="hero-intro"><p>Diseño y construyo sistemas web end-to-end con Node.js, TypeScript y PostgreSQL: APIs, datos, seguridad, integraciones, testing y operación.</p><p>Backend también con Go y Java / Spring Boot.</p></div>
        </div>
        <div class="hero-foot"><ul class="core-stack" aria-label="Stack principal"><li>Node.js</li><li>TypeScript</li><li>PostgreSQL</li><li>NestJS</li><li>Go</li><li>Java / Spring</li></ul><div class="hero-actions"><a class="action action-primary" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a><a class="action" href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a></div></div>
        <div class="hero-side-label">01 — SOFTWARE ENGINEERING DOSSIER</div>
      </section>

      <section id="proyectos" class="work-intro" aria-labelledby="work-title">
        <div class="chapter"><span>01</span><p>Selected work</p></div>
        <div class="work-intro-copy"><h2 id="work-title">Productos y sistemas<br />llevados de requerimiento a código.</h2><p>Backend, producto y operación como un mismo recorrido. Los primeros casos concentran sistemas transaccionales y editoriales; después, evidencia de realtime, seguridad, SaaS e IA aplicada.</p></div>
      </section>

      <section class="case elementos-case" aria-labelledby="elementos-title">
        <header class="case-header"><p class="case-number">01 / FEATURED CASE</p><div><p class="case-status">{elementos.status}</p><h2 id="elementos-title">Elementos</h2><p class="case-subtitle">Marketplace B2B/B2C</p></div><p class="case-lead">{elementos.summary}</p></header>
        <div class="elementos-media technical-media"><img src={elementos.media.src.src} width={elementos.media.src.width} height={elementos.media.src.height} alt={elementos.media.alt} loading="lazy" /><p class="media-caption">{elementos.media.caption}</p><div class="media-stamp">30+<span>módulos<br />de negocio</span></div></div>
        <div class="case-proof elementos-proof"><div><p class="label">SYSTEM</p><h3>Marketplace transaccional</h3><p>{elementos.problem}</p></div><div><div class="flow-diagram" aria-label="Flujo principal del marketplace"><span>CATÁLOGO</span><i>→</i><span>CARRITO / STOCK</span><i>→</i><span>CHECKOUT</span><i>→</i><span>PAGOS</span><i>→</i><span>ÓRDENES</span></div><div class="case-highlights"><article><strong>Backend modular</strong><span>Node / Express / PostgreSQL / Sequelize</span></article><article><strong>Pagos</strong><span>Mercado Pago, webhooks, conciliación y refunds</span></article><article><strong>Confiabilidad</strong><span>Idempotencia, locks, jobs y observabilidad</span></article></div></div></div>
        <footer class="case-footer"><p><span class="label">ROLE</span>{elementos.responsibility}</p><ul aria-label="Stack de Elementos">{elementos.stack.map((item) => <li>{item}</li>)}</ul><div>{elementos.links.map((link) => <a class="text-link" href={link.href} {...externalProps(link.external)}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></footer>
        <details class="case-details"><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{elementos.decisions.map((decision) => <li>{decision}</li>)}</ul></details>
      </section>

      <section class="case editor-case" aria-labelledby="editor-title">
        <header class="case-header"><p class="case-number">02 / FEATURED CASE</p><div><p class="case-status">{editor.status}</p><h2 id="editor-title">El Editor</h2><p class="case-subtitle">CMS editorial multitenant + portales públicos</p></div><p class="case-lead">{editor.summary}</p></header>
        <div class="editor-layout"><div class="editor-system" aria-label="Ecosistema técnico de El Editor"><p class="label">EDITORIAL ECOSYSTEM</p><div class="system-node api">Node / Express<br /><span>API + RBAC</span></div><div class="system-branch"><div class="system-node">React CMS<br /><span>workflow / media</span></div><div class="system-node">Next.js portals<br /><span>ISR / SEO</span></div></div><div class="system-node websub">WebSub notifier<br /><span>publicación / distribución</span></div></div><figure class="technical-media editor-media"><img src={editor.media.src.src} width={editor.media.src.width} height={editor.media.src.height} alt={editor.media.alt} loading="lazy" /><figcaption>{editor.media.caption}</figcaption></figure></div>
        <div class="case-proof editor-proof"><div><p class="label">SYSTEM</p><h3>Una operación editorial, múltiples salidas públicas.</h3><p>{editor.problem}</p></div><div class="case-highlights"><article><strong>Multitenancy / RBAC</strong><span>Permisos y flujo editorial dentro de la aplicación</span></article><article><strong>Publicación</strong><span>CMS React, portales Next.js, ISR y revalidación</span></article><article><strong>Operación</strong><span>S3 / CloudFront, WebSub, SEO y analytics</span></article></div></div>
        <footer class="case-footer"><p><span class="label">ROLE</span>{editor.responsibility}</p><ul aria-label="Stack de El Editor">{editor.stack.map((item) => <li>{item}</li>)}</ul><div>{editor.links.map((link) => <a class="text-link" href={link.href} {...externalProps(link.external)}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></footer>
        <details class="case-details"><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{editor.decisions.map((decision) => <li>{decision}</li>)}</ul></details>
      </section>

      <section class="case minecall-case" aria-labelledby="minecall-title">
        <div class="minecall-copy"><p class="case-number">03 / REALTIME SYSTEMS</p><p class="case-status">{minecall.status}</p><h2 id="minecall-title">MineCall</h2><p class="case-subtitle">Oficina virtual en tiempo real</p><p class="case-lead">{minecall.summary}</p><div class="minecall-stack" aria-label="Tecnologías destacadas"><span>GO</span><span>WEBSOCKETS</span><span>REDIS</span><span>LIVEKIT</span><span>POSTGRESQL</span></div><a class="text-link" href={minecall.links[0].href} {...externalProps(minecall.links[0].external)}>Abrir MineCall <span aria-hidden="true">↗</span></a></div>
        <figure class="technical-media minecall-media"><img src={minecall.media.src.src} width={minecall.media.src.width} height={minecall.media.src.height} alt={minecall.media.alt} loading="lazy" /><figcaption>{minecall.media.caption}</figcaption></figure>
        <div class="minecall-notes"><div><p class="label">SYSTEM</p><p>{minecall.problem}</p></div><div><p class="label">ENGINEERING</p><p>Protocolos versionados, presence distribuida, reconnect/replay, backpressure, transactional outbox y pruebas de carga.</p></div><div><p class="label">SCOPE</p><p>LiveKit resuelve media y proximidad; no implementé WebRTC ni un SFU.</p></div></div>
        <details class="case-details"><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{minecall.decisions.map((decision) => <li>{decision}</li>)}</ul></details>
      </section>

      <section class="specialized" aria-labelledby="specialized-title"><div class="chapter"><span>04—06</span><p>Specialized evidence</p></div><h2 id="specialized-title">Seguridad, consistencia<br />y tooling aplicado.</h2>
        <div class="specialized-grid">
          <article class="specialized-card cercaya-card"><p class="case-number">04 / JAVA + SECURITY</p><p class="case-status">{cercaya.status}</p><h3>Cercaya</h3><p class="card-subtitle">Marketplace de servicios a domicilio</p><p>{cercaya.summary}</p><div class="evidence-foundation"><strong>Private Evidence Foundation</strong><span>Contextual auth · EXIF stripping · SHA-256 integrity · Audit trail</span></div><ul class="word-stack"><li>Java</li><li>Spring Boot</li><li>Spring Modulith</li><li>PostgreSQL</li><li>OIDC</li></ul><a class="text-link" href={cercaya.links[0].href}>Pedir caso técnico <span aria-hidden="true">↗</span></a></article>
          <article class="specialized-card chemical-card"><p class="case-number">05 / SAAS + INVENTORY</p><p class="case-status">{chemical.status}</p><h3>Chemical<br />Software</h3><p class="card-subtitle">SaaS de gestión multicomercio</p><p>{chemical.summary}</p><div class="tenant-map" aria-label="Alcance de tenants"><span>PLATAFORMA</span><i>↓</i><span>COMERCIO</span><i>↓</i><span>SUCURSALES</span><i>↓</i><span>ADMIN / STAFF</span></div><ul class="word-stack"><li>NestJS</li><li>Multi-tenancy</li><li>Inventory</li><li>Audit</li><li>PostgreSQL</li></ul><a class="text-link" href={chemical.links[0].href}>Pedir caso técnico <span aria-hidden="true">↗</span></a></article>
          <article class="specialized-card memories-card"><p class="case-number">06 / RESEARCH TOOLING</p><p class="case-status">{memories.status}</p><h3>MemoriesAI</h3><p class="card-subtitle">Memoria durable y verificable para agentes</p><p>{memories.summary}</p><figure class="memories-diagram"><img src={memories.media.src.src} width={memories.media.src.width} height={memories.media.src.height} alt={memories.media.alt} loading="lazy" /><figcaption>Markdown → lifecycle → BM25 → contexto acotado → agente</figcaption></figure><p class="experimental-note">Vector / hybrid: experimental y opt-in.</p><ul class="word-stack"><li>Python</li><li>BM25</li><li>SQLite</li><li>FTS5</li><li>CLI</li></ul><a class="text-link" href={memories.links[0].href}>Pedir caso técnico <span aria-hidden="true">↗</span></a></article>
        </div>
      </section>

      <section class="other-work" aria-labelledby="other-work-title"><div class="chapter"><span>07+</span><p>Other work / experiments</p></div><div class="other-work-heading"><h2 id="other-work-title">Otros productos.</h2><p>Experiencia adicional que amplía el recorrido sin competir con los casos centrales.</p></div>
        <div class="other-work-list">{otherProjects.map((project) => <article><p>{project.index} / {project.status}</p><h3>{project.title}</h3><p>{project.summary}</p><ul>{project.stack.map((item) => <li>{item}</li>)}</ul>{project.links.length > 0 && <a class="text-link" href={project.links[0].href} {...externalProps(project.links[0].external)}>{project.links[0].label} <span aria-hidden="true">↗</span></a>}</article>)}<article><p>08 / MVP B2B SaaS</p><h3>DATAMARK</h3><p>MVP B2B SaaS de ventas, inventario, clientes y analítica desarrollado en equipo. Lideré el backend con Node.js, TypeScript, Express, PostgreSQL y Prisma, implementando JWT/RBAC y dashboards.</p><ul><li>Node.js</li><li>TypeScript</li><li>Express</li><li>PostgreSQL</li><li>Prisma</li><li>React</li></ul></article></div>
      </section>

      <section id="experiencia" class="experience" aria-labelledby="experience-title"><div class="chapter"><span>02</span><p>Experience</p></div><div class="experience-heading"><h2 id="experience-title">Trabajo sobre productos,<br />no sólo interfaces.</h2><p>Experiencia en desarrollo, producto y operación que ubica el recorrido de los casos técnicos.</p></div><div class="experience-list">{experience.map((item, index) => <article class:list={[index === 0 && "current-role"]}><time>{item.date}</time><div><h3>{item.role}</h3><p>{item.company}</p></div><p>{item.description}</p></article>)}</div></section>

      <section id="stack" class="stack-section" aria-labelledby="stack-title"><div class="chapter"><span>03</span><p>Capabilities</p></div><div class="stack-heading"><h2 id="stack-title">Stack organizado<br />por responsabilidad.</h2><p>Node.js, TypeScript y PostgreSQL son el núcleo. El resto acompaña problemas concretos de backend, datos, frontend, calidad y operación.</p></div><div class="capability-table">{capabilities.map((capability) => <article><p>{capability.index}</p><h3>{capability.title}</h3><span>{capability.description}</span><ul>{capability.items.map((item) => <li>{item}</li>)}</ul></article>)}</div></section>
      <section class="working-method" aria-labelledby="method-title"><div class="chapter"><span>04</span><p>How I work</p></div><h2 id="method-title">De requerimiento<br />a operación.</h2><div class="method-list"><article><span>01</span><h3>Producto</h3><p>Entender el problema y los flujos antes de implementar.</p></article><article><span>02</span><h3>Backend</h3><p>Diseñar contratos, datos, seguridad, consistencia e integraciones.</p></article><article><span>03</span><h3>Quality</h3><p>Testing, observabilidad y casos de falla como parte del sistema.</p></article><article><span>04</span><h3>AI</h3><p>Codex y Claude Code para análisis, implementación, testing y review dentro de workflows basados en especificaciones.</p></article></div></section>
      <section class="education" aria-label="Educación e idiomas"><article><p class="label">EDUCACIÓN</p><h2>Licenciatura en Informática</h2><p>Universidad Nacional de Quilmes<br />En curso · 2025 — Actualidad</p></article><article><p class="label">IDIOMAS</p><h2>Español e inglés técnico</h2><p>Español: nativo<br />Inglés: lectura fluida de documentación técnica; conversación básica</p></article></section>
      <section id="contacto" class="contact" aria-labelledby="contact-title"><p class="case-number">CONTACT / 2026</p><h2 id="contact-title">Backend /<br /><em>Full Stack.</em></h2><div><p>Buenos Aires, Argentina<br />Remote LATAM / Buenos Aires</p><a class="contact-email" href={links.email.href}>{profile.email} <span aria-hidden="true">↗</span></a></div><nav aria-label="Redes y contacto"><a href={links.linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={links.github.href} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.cvPath} download>Descargar CV ↗</a></nav></section>
    </main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.footerNote}</span></footer>
  </body>
</html>

<style is:global>
  :root{color-scheme:dark;--ink:#111214;--panel:#17181b;--paper:#f2f0e9;--paper-muted:#c4c1b7;--muted:#92949b;--line:rgba(242,240,233,.18);--line-dark:rgba(17,18,20,.16);--accent:#d4aa4c;--accent-deep:#9a752d;--page:1360px;--gutter:clamp(20px,4vw,64px);--ease:cubic-bezier(.16,1,.3,1)}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--ink)}body{min-width:320px;margin:0;color:var(--paper);background:var(--ink);font-family:"IBM Plex Sans Variable","IBM Plex Sans",Arial,sans-serif;font-size:16px;line-height:1.55;text-rendering:optimizeLegibility}h1,h2,h3,p,ul,figure,figcaption{margin:0}ul{padding:0;list-style:none}a{color:inherit;text-decoration:none}[id]{scroll-margin-top:96px}:focus-visible{outline:2px solid var(--accent);outline-offset:5px}::selection{color:var(--ink);background:var(--accent)}.skip-link{position:fixed;top:12px;left:12px;z-index:50;padding:10px 14px;color:var(--ink);background:var(--accent);font-weight:700;transform:translateY(-170%)}.skip-link:focus{transform:none}.site-header,.hero,.work-intro,.case,.specialized,.other-work,.experience,.working-method,.education,.site-footer{width:min(calc(100% - var(--gutter)*2),var(--page));margin-inline:auto}.site-header{position:sticky;top:0;z-index:20;min-height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--ink) 91%,transparent);backdrop-filter:blur(10px)}.brand{font-size:.68rem;font-weight:760;letter-spacing:.1em;line-height:1.15}.site-header nav{display:flex;gap:clamp(14px,2vw,28px);color:var(--paper-muted);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase}.site-header nav a,.text-link,.contact nav a{transition:color 180ms ease}.site-header nav a:hover,.text-link:hover,.contact nav a:hover{color:var(--accent)}.header-status{justify-self:end;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.61rem;letter-spacing:.05em}.header-status span{display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:var(--accent)}
  .hero{position:relative;min-height:calc(88svh - 76px);display:grid;grid-template-rows:auto 1fr auto auto;padding-block:26px 36px;overflow:hidden}.hero::after{position:absolute;right:0;bottom:31%;width:min(40vw,530px);height:1px;background:var(--line);content:""}.hero-topline,.hero-foot{display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.64rem;letter-spacing:.09em;text-transform:uppercase}.hero-title{align-self:center;padding-block:44px 28px}.hero-name{margin-bottom:16px;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase}.hero h1{max-width:9ch;font-size:clamp(4.7rem,9.4vw,8.25rem);font-weight:620;letter-spacing:-.075em;line-height:.84}h1 em,.contact h2 em{color:var(--paper-muted);font-style:normal;font-weight:350}.hero-lower{display:grid;grid-template-columns:minmax(220px,.77fr) minmax(300px,.8fr);gap:clamp(40px,9vw,150px);align-items:end;padding-bottom:30px}.hero-scope{font-size:clamp(1.2rem,2vw,1.7rem);font-weight:600;letter-spacing:-.04em;line-height:1.06}.hero-scope span{color:var(--muted);font-size:.6em;font-weight:400;letter-spacing:-.015em}.hero-intro{max-width:540px;color:var(--paper-muted);font-size:clamp(1rem,1.35vw,1.2rem);line-height:1.52}.hero-intro p+p{margin-top:9px;color:var(--accent);font-size:.78em}.hero-foot{align-items:center;padding-top:21px;border-top:1px solid var(--line)}.core-stack{display:flex;flex-wrap:wrap;gap:5px 17px;color:var(--paper);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase}.core-stack li:not(:last-child)::after{margin-left:17px;color:var(--accent);content:"/"}.hero-actions{display:flex;flex-wrap:wrap;gap:11px}.action{min-height:40px;display:inline-flex;align-items:center;gap:14px;padding:0 15px;border:1px solid var(--line);color:var(--paper);font-size:.76rem;font-weight:650;transition:background-color 180ms ease,color 180ms ease,transform 180ms var(--ease)}.action:hover{color:var(--ink);background:var(--paper);transform:translateY(-2px)}.action-primary{border-color:var(--accent);color:var(--ink);background:var(--accent)}.action-primary:hover{background:var(--paper)}.hero-side-label{position:absolute;right:0;top:50%;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.58rem;letter-spacing:.1em;writing-mode:vertical-rl;transform:translateY(-50%)}
  .chapter{display:flex;align-items:center;gap:12px;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.66rem;letter-spacing:.1em;text-transform:uppercase}.chapter span{min-width:46px;color:inherit;font-size:.84rem}.chapter::after{flex:1;max-width:90px;height:1px;background:currentColor;content:"";opacity:.72}.work-intro{display:grid;grid-template-columns:minmax(170px,.25fr) 1fr;gap:clamp(32px,7vw,120px);padding-block:clamp(100px,12vw,160px) 64px}.work-intro-copy{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(250px,.55fr);gap:clamp(30px,7vw,110px);align-items:end}.work-intro h2,.experience h2,.stack-section h2,.working-method h2{font-size:clamp(2.85rem,5.7vw,5.4rem);font-weight:520;letter-spacing:-.07em;line-height:.92}.work-intro-copy>p,.experience-heading>p,.stack-heading>p{max-width:380px;color:var(--paper-muted);font-size:1rem}
