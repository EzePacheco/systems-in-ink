---
import "@fontsource-variable/ibm-plex-sans";
import { capabilities, experience, heroActions, links, metadata, profile, projects } from "../data/portfolio.data";

const mainProjects = projects.slice(0, 6);
const otherProjects = projects.slice(6);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: "https://portfolio-eze-pacheco.vercel.app/",
  jobTitle: profile.role,
  email: profile.email,
  address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
  sameAs: [links.linkedin.href, links.github.href],
  knowsAbout: ["Node.js", "TypeScript", "PostgreSQL", "NestJS", "Express", "Go", "Java", "Spring Boot", "React", "Next.js", "Software architecture", "Web application security"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metadata.description} />
    <meta name="keywords" content="Backend Developer, Full Stack Developer, Node.js, TypeScript, PostgreSQL, NestJS, Go, Java, Spring Boot, React, Next.js" />
    <meta name="theme-color" content="#24241f" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://portfolio-eze-pacheco.vercel.app/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content="https://portfolio-eze-pacheco.vercel.app/" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <meta property="og:image:alt" content="Portfolio profesional de Ezequiel Pacheco" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{metadata.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">Ezequiel Pacheco</a>
      <nav aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a><a href="#capacidades">Stack</a><a href="#experiencia">Experiencia</a><a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cta" href={profile.cvPath} download>Descargar CV</a>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">{profile.role}</p>
          <h1 id="hero-title">Backend Developer <span>con alcance Full Stack.</span></h1>
          <p class="hero-description">{profile.heroDescription}</p>
          <ul class="hero-stack" aria-label="Stack principal"><li>Node.js</li><li>TypeScript</li><li>PostgreSQL</li><li>NestJS</li><li>Go</li><li>Java / Spring Boot</li></ul>
          <div class="hero-actions" aria-label="Acciones principales">
            {heroActions.map((action, index) => (
              <a class:list={["button", index === 0 && "primary", action.download && "cv-button"]} href={action.href} target={action.external ? "_blank" : undefined} rel={action.external ? "noopener noreferrer" : undefined} download={action.download ? true : undefined}>
                {action.label}{action.external && <span aria-hidden="true">↗</span>}
              </a>
            ))}
          </div>
        </div>
        <aside class="hero-summary" aria-label="Resumen profesional">
          <p class="summary-label">En 30 segundos</p>
          <dl>
            <div><dt>Especialidad</dt><dd>Backend, datos, seguridad e integraciones</dd></div>
            <div><dt>Alcance</dt><dd>Producto end-to-end: diseño, implementación, testing y operación</dd></div>
            <div><dt>Ubicación</dt><dd>{profile.location}</dd></div>
          </dl>
          <p class="availability">Open to Backend / Full Stack opportunities — Remote LATAM / Buenos Aires.</p>
        </aside>
      </section>

      <section id="resumen" class="profile-section" aria-labelledby="resumen-title">
        <div class="section-heading"><p class="eyebrow">Perfil profesional</p><h2 id="resumen-title">Backend como especialidad. Producto completo como alcance.</h2></div>
        <div class="profile-copy">
          <p>Soy Backend / Full Stack Developer con foco en Node.js, TypeScript y PostgreSQL. Diseño y construyo sistemas web end-to-end: APIs, modelado de datos, seguridad, integraciones, testing, CI/CD y operación.</p>
          <p>Actualmente trabajo en una empresa privada desarrollando plataformas digitales. Participo desde el relevamiento de necesidades y definición de flujos hasta arquitectura, implementación, pruebas y evolución de sistemas.</p>
          <p>Mi stack principal es Node.js/TypeScript, y también desarrollo backend con Go y Java/Spring Boot.</p>
        </div>
      </section>

      <section id="proyectos" class="projects" aria-labelledby="proyectos-title">
        <div class="section-heading project-heading"><div><p class="eyebrow">Trabajo seleccionado</p><h2 id="proyectos-title">Sistemas reales, decisiones técnicas y evidencia.</h2></div><p>Seis casos para recorrer profundidad en marketplace, CMS, realtime, seguridad, SaaS e IA aplicada.</p></div>
        <div class="project-grid">
          {mainProjects.map((project) => (
            <article class="project-card" id={`proyecto-${project.id}`}>
              <header><div class="project-meta"><span>{project.index}</span><span>{project.status}</span></div><h3>{project.title}</h3><p>{project.summary}</p></header>
              <div class="project-body"><p><strong>Mi trabajo:</strong> {project.responsibility}</p><ul class="evidence-list" aria-label={`Evidencia de ${project.title}`}>{project.evidence.map((item) => <li>{item}</li>)}</ul></div>
              <details><summary>Ver detalle técnico</summary><ul class="technical-list">{project.decisions.map((decision) => <li>{decision}</li>)}</ul></details>
              <footer>
                <ul class="stack-list" aria-label={`Tecnologías de ${project.title}`}>{project.stack.map((item) => <li>{item}</li>)}</ul>
                <div class="project-links">{project.links.map((link) => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}</div>
              </footer>
            </article>
          ))}
        </div>
      </section>

      <section class="other-projects" aria-labelledby="otros-title">
        <div class="section-heading"><p class="eyebrow">Otros productos / proyectos</p><h2 id="otros-title">Experiencia adicional relevante.</h2></div>
        <div class="other-grid">
          {otherProjects.map((project) => (
            <article><p class="project-meta"><span>{project.index}</span><span>{project.status}</span></p><h3>{project.title}</h3><p>{project.summary}</p><ul class="stack-list" aria-label={`Tecnologías de ${project.title}`}>{project.stack.map((item) => <li>{item}</li>)}</ul><div class="project-links">{project.links.map((link) => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}</div></article>
          ))}
          <article><p class="project-meta"><span>08</span><span>MVP B2B SaaS</span></p><h3>DATAMARK</h3><p>MVP B2B SaaS de ventas, inventario, clientes y analítica desarrollado en equipo. Lideré el backend con Node.js, TypeScript, Express, PostgreSQL y Prisma, implementando JWT/RBAC y dashboards.</p><ul class="stack-list" aria-label="Tecnologías de DATAMARK"><li>Node.js</li><li>TypeScript</li><li>Express</li><li>PostgreSQL</li><li>Prisma</li><li>React</li></ul></article>
        </div>
      </section>

      <section id="capacidades" class="capabilities" aria-labelledby="capacidades-title">
        <div class="section-heading project-heading"><div><p class="eyebrow">Stack y competencias</p><h2 id="capacidades-title">Tecnología organizada por responsabilidad.</h2></div><p>El foco está en las capacidades aplicadas en sistemas, no en acumular logos.</p></div>
        <div class="capability-grid">{capabilities.map((capability) => <article><p class="capability-index">{capability.index}</p><h3>{capability.title}</h3><p>{capability.description}</p><ul>{capability.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
      </section>

      <section class="how-i-work" aria-labelledby="forma-title">
        <div class="section-heading"><p class="eyebrow">Forma de trabajo</p><h2 id="forma-title">Del problema a un sistema que se puede operar.</h2></div>
        <div class="work-grid">
          <article><h3>Backend</h3><p>Diseño de APIs, datos, seguridad, consistencia e integraciones.</p></article>
          <article><h3>Producto</h3><p>Entiendo el problema y los flujos antes de implementar.</p></article>
          <article><h3>End-to-end ownership</h3><p>Requerimiento → diseño → implementación → testing → deploy / operación.</p></article>
          <article><h3>AI-assisted engineering</h3><p>Uso agentes para análisis, implementación, pruebas y revisión, manteniendo responsabilidad técnica humana.</p></article>
        </div>
      </section>

      <section id="experiencia" class="experience" aria-labelledby="experiencia-title">
        <div class="section-heading project-heading"><div><p class="eyebrow">Experiencia</p><h2 id="experiencia-title">Trayectoria profesional.</h2></div><p>Experiencia en desarrollo, producto y operación que complementa los casos técnicos.</p></div>
        <div class="experience-list">{experience.map((item) => <article><time>{item.date}</time><div><h3>{item.company}</h3><p>{item.role}</p></div><p>{item.description}</p></article>)}</div>
      </section>

      <section class="education" aria-labelledby="educacion-title">
        <article><p class="eyebrow">Educación</p><h2 id="educacion-title">Licenciatura en Informática</h2><p>Universidad Nacional de Quilmes · En curso | 2025 – Actualidad</p></article>
        <article><p class="eyebrow">Idiomas</p><h2>Español e inglés técnico</h2><p>Español: nativo · Inglés: lectura fluida de documentación técnica; conversación básica</p></article>
      </section>

      <section id="contacto" class="contact" aria-labelledby="contacto-title">
        <div><p class="eyebrow">Contacto</p><h2 id="contacto-title">¿Buscás un Backend / Full Stack Developer?</h2><p>Buenos Aires, Argentina · Remoto LATAM o Buenos Aires</p></div>
        <div class="contact-links" aria-label="Canales de contacto"><a class="button primary" href={links.email.href}>Escribirme</a><a href={links.linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={links.github.href} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>

    <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.footerNote}</span></footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; --paper: #fff; --surface: #f4f4f1; --surface-strong: #eee5cb; --ink: #1e1e1b; --muted: #62645f; --line: #deded8; --accent: #d8ad38; --accent-deep: #856112; --night: #24241f; --page: 1180px; --gutter: clamp(20px, 4vw, 56px); --ease: cubic-bezier(.16, 1, .3, 1); }
  * { box-sizing: border-box; } html { scroll-behavior: smooth; background: var(--paper); } body { min-width: 320px; margin: 0; color: var(--ink); background: var(--paper); font-family: "IBM Plex Sans Variable", "IBM Plex Sans", Arial, sans-serif; font-size: 16px; line-height: 1.55; text-rendering: optimizeLegibility; } h1, h2, h3, p, dl, dd, ul { margin: 0; } a { color: inherit; text-decoration: none; } :focus-visible { outline: 3px solid var(--accent-deep); outline-offset: 4px; }
  .skip-link { position: fixed; top: 10px; left: 10px; z-index: 20; padding: 10px 14px; color: var(--paper); background: var(--night); transform: translateY(-180%); } .skip-link:focus { transform: none; }
  .site-header, .hero, .profile-section, .projects, .other-projects, .capabilities, .how-i-work, .experience, .education, .site-footer { width: min(calc(100% - (var(--gutter) * 2)), var(--page)); margin-inline: auto; }
  .site-header { min-height: 76px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: center; } .brand { width: fit-content; font-weight: 720; letter-spacing: -.02em; } .site-header nav { display: flex; gap: 24px; color: var(--muted); font-size: .82rem; } .site-header nav a, .header-cta, .project-links a { transition: color 180ms ease, transform 220ms var(--ease); } .site-header nav a:hover, .header-cta:hover, .project-links a:hover { color: var(--accent-deep); transform: translateY(-2px); } .header-cta { justify-self: end; color: var(--accent-deep); font-size: .82rem; font-weight: 680; }
  .hero { min-height: min(720px, calc(100svh - 76px)); display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(290px, .58fr); gap: clamp(40px, 8vw, 108px); align-items: center; padding-block: 50px; } .eyebrow, .summary-label, .project-meta, .capability-index, time { color: var(--accent-deep); font-size: .72rem; font-weight: 740; letter-spacing: .055em; text-transform: uppercase; } .hero h1 { max-width: 13ch; margin-top: 16px; font-size: clamp(3.15rem, 5.7vw, 5.45rem); font-weight: 650; letter-spacing: -.055em; line-height: .96; } .hero h1 span { display: block; color: var(--muted); font-weight: 440; } .hero-description { max-width: 720px; margin-top: 24px; color: var(--muted); font-size: clamp(1rem, 1.35vw, 1.15rem); }
  .hero-stack, .stack-list, .capability-grid ul { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; } .hero-stack { margin-top: 24px; } .hero-stack li { padding: 5px 9px; border-radius: 999px; color: var(--accent-deep); background: var(--surface-strong); font-size: .74rem; font-weight: 650; } .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; } .button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 16px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: var(--surface); font-size: .8rem; font-weight: 680; transition: transform 220ms var(--ease), background-color 180ms ease, border-color 180ms ease; } .button:hover { border-color: var(--accent); transform: translateY(-2px); } .button.primary { border-color: var(--accent); color: var(--ink); background: var(--accent); } .button.primary:hover { color: var(--paper); background: var(--accent-deep); }
  .hero-summary { padding: clamp(22px, 3vw, 32px); border-radius: 14px; background: var(--surface); } .hero-summary dl { display: grid; gap: 20px; margin-top: 20px; } .hero-summary dl div { display: grid; gap: 3px; } .hero-summary dt { color: var(--muted); font-size: .74rem; } .hero-summary dd { font-size: .92rem; font-weight: 620; } .availability { margin-top: 25px; padding-top: 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; }
  .profile-section, .projects, .other-projects, .capabilities, .how-i-work, .experience { padding-block: clamp(52px, 7vw, 88px); border-top: 1px solid var(--line); } .section-heading { max-width: 820px; } .section-heading h2 { margin-top: 12px; font-size: clamp(2.15rem, 3.8vw, 3.65rem); font-weight: 580; letter-spacing: -.045em; line-height: 1.03; } .project-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .48fr); gap: 44px; align-items: end; max-width: none; margin-bottom: 32px; } .project-heading > p { color: var(--muted); font-size: .92rem; } .profile-section { display: grid; grid-template-columns: minmax(0, .82fr) minmax(320px, .9fr); gap: clamp(38px, 8vw, 110px); align-items: start; } .profile-copy { display: grid; gap: 17px; color: var(--muted); font-size: 1rem; } .profile-copy p:first-child { color: var(--ink); font-size: 1.08rem; }
  .projects { background: linear-gradient(180deg, #fff, #faf9f5); } .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } .project-card { display: flex; flex-direction: column; min-width: 0; padding: clamp(24px, 3vw, 34px); border: 1px solid var(--line); border-radius: 15px; background: var(--surface); } .project-card:nth-child(-n+2) { background: var(--night); color: var(--paper); border-color: var(--night); } .project-meta { display: flex; justify-content: space-between; gap: 12px; color: var(--accent-deep); } .project-card:nth-child(-n+2) .project-meta { color: #efc451; } .project-card h3, .other-grid h3 { margin-top: 16px; font-size: clamp(1.45rem, 2.25vw, 2rem); font-weight: 660; letter-spacing: -.035em; line-height: 1.08; } .project-card header > p { margin-top: 15px; color: var(--muted); font-size: .92rem; } .project-card:nth-child(-n+2) header > p, .project-card:nth-child(-n+2) .project-body { color: #d1c8b7; } .project-body { margin-top: 21px; color: var(--muted); font-size: .83rem; } .project-body strong { color: var(--ink); } .project-card:nth-child(-n+2) .project-body strong { color: var(--paper); }
  .evidence-list, .technical-list { display: grid; gap: 7px; padding: 0; list-style: none; } .evidence-list { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 19px; font-size: .76rem; } .evidence-list li { position: relative; padding-left: 13px; } .evidence-list li::before { position: absolute; top: .62em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent-deep); content: ""; } .project-card:nth-child(-n+2) .evidence-list li::before { background: #efc451; } details { margin-top: 24px; padding-top: 17px; border-top: 1px solid var(--line); } .project-card:nth-child(-n+2) details { border-color: rgba(255,255,255,.18); } summary { cursor: pointer; font-size: .8rem; font-weight: 690; } .technical-list { margin-top: 14px; padding-left: 18px; list-style: disc; color: var(--muted); font-size: .78rem; } .project-card:nth-child(-n+2) .technical-list { color: #d1c8b7; } .technical-list li + li { margin-top: 9px; }
  .project-card footer { display: grid; gap: 16px; margin-top: auto; padding-top: 25px; } .stack-list li, .capability-grid li { padding: 4px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: .68rem; } .project-card:nth-child(-n+2) .stack-list li { border-color: rgba(255,255,255,.22); color: #d1c8b7; } .project-links { display: flex; flex-wrap: wrap; gap: 14px; } .project-links a { display: inline-flex; gap: 6px; align-items: center; color: var(--accent-deep); font-size: .77rem; font-weight: 680; } .project-card:nth-child(-n+2) .project-links a { color: #efc451; }
  .other-projects { padding-top: 0; border-top: 0; } .other-projects .section-heading, .how-i-work .section-heading { margin-bottom: 24px; } .other-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } .other-grid article { padding: 26px; border-radius: 13px; background: var(--surface); } .other-grid article > p:not(.project-meta) { margin-top: 13px; color: var(--muted); font-size: .84rem; } .other-grid .stack-list, .other-grid .project-links { margin-top: 18px; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; } .capability-grid article { min-width: 0; padding: 24px; border-radius: 12px; background: var(--surface); } .capability-grid h3 { margin-top: 11px; font-size: 1.08rem; font-weight: 680; } .capability-grid article > p:not(.capability-index) { min-height: 48px; margin-top: 10px; color: var(--muted); font-size: .77rem; } .capability-grid ul { margin-top: 17px; }
  .how-i-work { padding-top: 0; border-top: 0; } .work-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } .work-grid article { padding: 24px; border-top: 3px solid var(--accent); background: var(--night); color: var(--paper); } .work-grid h3 { font-size: 1rem; } .work-grid p { margin-top: 11px; color: #d1c8b7; font-size: .79rem; }
  .experience-list { display: grid; gap: 10px; } .experience-list article { display: grid; grid-template-columns: minmax(155px, .33fr) minmax(250px, .52fr) minmax(0, 1fr); gap: 32px; align-items: center; padding: 24px; border-radius: 12px; background: var(--surface); } .experience-list h3 { font-size: 1.08rem; font-weight: 680; } .experience-list div p { margin-top: 4px; color: var(--accent-deep); font-size: .77rem; font-weight: 650; } .experience-list article > p { color: var(--muted); font-size: .8rem; }
  .education { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding-bottom: clamp(52px, 7vw, 88px); } .education article { padding: 28px; border-radius: 13px; background: var(--surface); } .education h2 { margin-top: 12px; font-size: 1.3rem; letter-spacing: -.025em; } .education article > p:last-child { margin-top: 8px; color: var(--muted); font-size: .84rem; }
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 50px; align-items: center; padding: clamp(52px, 7vw, 82px) max(var(--gutter), calc((100vw - var(--page)) / 2)); color: var(--ink); background: var(--accent); } .contact h2 { max-width: 17ch; margin-top: 12px; font-size: clamp(2.3rem, 4vw, 3.8rem); font-weight: 570; letter-spacing: -.045em; line-height: 1.02; } .contact div > p:last-child { margin-top: 16px; color: #55431f; } .contact-links { display: flex; flex-wrap: wrap; gap: 17px; align-items: center; } .contact-links > a:not(.button) { font-size: .8rem; font-weight: 680; } .site-footer { min-height: 78px; display: flex; justify-content: space-between; gap: 24px; align-items: center; color: var(--muted); font-size: .72rem; }
  @media (max-width: 900px) { .project-grid, .other-grid { grid-template-columns: 1fr; } .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hero { grid-template-columns: 1fr; min-height: auto; } .project-heading, .profile-section { grid-template-columns: 1fr; gap: 22px; } }
  @media (max-width: 680px) { .site-header { min-height: 66px; grid-template-columns: 1fr auto; } .site-header nav { display: none; } .hero { padding-block: 38px 48px; } .hero h1 { font-size: clamp(2.75rem, 12vw, 3.8rem); } .hero-actions { gap: 8px; } .button { min-height: 42px; padding-inline: 13px; } .hero-summary, .project-card { padding: 22px; } .evidence-list, .capability-grid, .work-grid, .education { grid-template-columns: 1fr; } .experience-list article { grid-template-columns: 1fr; gap: 9px; } .contact { grid-template-columns: 1fr; gap: 30px; } .site-footer { min-height: 92px; align-items: flex-start; flex-direction: column; justify-content: center; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; } }
</style>
