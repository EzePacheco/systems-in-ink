---
import HomePage from '../components/HomePage.astro';
import { getPortfolio } from '../data/portfolio.data';
import BaseLayout from '../layouts/BaseLayout.astro';
const content = getPortfolio('es');
---
<BaseLayout locale="es" title={content.metadata.title} description={content.metadata.description} ogImage={content.metadata.ogImage} alternatePath="/en/">
  <HomePage content={content} />
</BaseLayout>
