---
import { Image } from "astro:assets";
import ProjectGallery from "../components/ProjectGallery.astro";
import ActionLink from "../components/ActionLink.astro";
import portrait from "../assets/profile/ezequiel-pacheco.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilities, datamark, experience, links, profile, projects, getProject } from "../data/portfolio.data";

const elementos = getProject("elementos");
const editor = getProject("el-editor-cms");
const minecall = getProject("minecall");
const cercaya = getProject("cercaya");
const chemical = getProject("chemical-software");
const memories = getProject("memoriesai");
const others = projects.filter((item) => ![elementos, editor, minecall, cercaya, chemical, memories].some((project) => project.id === item.id));
---

<BaseLayout>
    <main id="contenido">
      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow hero-location" data-hero-reveal style="--reveal-delay: 0ms"><span>{profile.location}</span><span class="hero-location__separator" aria-hidden="true"> · </span><span>Remoto LATAM</span></p>
          <h1 id="hero-title" data-hero-reveal style="--reveal-delay: 70ms">Backend Developer <em>con alcance Full Stack.</em></h1>
          <p class="lead" data-hero-reveal style="--reveal-delay: 140ms">Desarrollo APIs y modelos de datos con Node.js, TypeScript y PostgreSQL, con foco en autorización, consistencia transaccional, procesamiento asíncrono e integraciones.</p>
          <p class="secondary" data-hero-reveal style="--reveal-delay: 190ms">React y Next.js para el alcance Full Stack; experiencia adicional con Go, Java/Spring Boot y Python.</p>
        </div>
        <figure class="hero-portrait" data-hero-reveal style="--reveal-delay: 120ms"><Image src={portrait} widths={[220, 340, 440, 680]} sizes="(max-width: 680px) 220px, 340px" format="webp" quality={80} alt="Retrato de Ezequiel Pacheco" loading="eager" decoding="async" fetchpriority="high" /></figure>
      </section>

      <section id="proyectos" class="selected-work" aria-labelledby="work-title">
        <header class="work-intro" data-reveal>
          <div>
            <h2 id="work-title">Proyectos seleccionados</h2>
          </div>
        </header>

        <article class="project editor" aria-labelledby="editor-title">
          <div class="editor-layout">
            <header class="editor-intro" data-project-copy data-reveal>
              <h3 id="editor-title">{editor.title}</h3>
              <p>{editor.summary}</p>
            </header>
            <div class="editor-media" data-reveal="media" data-reveal-delay="80"><ProjectGallery images={editor.gallery ?? []} label="El Editor" priority /></div>
            <div class="editor-contribution" data-project-copy data-reveal>
              <p>{editor.responsibility}</p>
              <ul class="pills" aria-label="Tecnologías de El Editor">{editor.stack.map((item) => <li>{item}</li>)}</ul>
              <div class="links">{editor.links.map((link) => <ActionLink href={link.href} label={link.label} external={link.external} />)}</div>
            </div>
          </div>
          <details><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{editor.decisions.map((item) => <li>{item}</li>)}</ul></details>
        </article>

        <article class="project elementos" aria-labelledby="elementos-title">
          <div class="elementos-layout">
            <header class="elementos-intro" data-project-copy data-reveal>
              <h3 id="elementos-title">{elementos.title}</h3>
              <p>{elementos.summary}</p>
            </header>
            <div class="elementos-media" data-reveal="media" data-reveal-delay="70"><ProjectGallery images={elementos.gallery ?? []} label="Elementos" /></div>
            <div class="elementos-contribution" data-project-copy data-reveal>
              <p>{elementos.responsibility}</p>
              <ul class="pills" aria-label="Tecnologías de Elementos">{elementos.stack.map((item) => <li>{item}</li>)}</ul>
              <div class="links">{elementos.links.map((link) => <ActionLink href={link.href} label={link.label} external={link.external} />)}</div>
            </div>
          </div>
          <details><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{elementos.decisions.map((item) => <li>{item}</li>)}</ul></details>
        </article>

        <div class="selected-secondary">
          <article id="chemical-software" class="project chemical compact-case" aria-labelledby="chemical-title" data-reveal>
            <div class="chemical-copy">
              <h3 id="chemical-title">{chemical.title}</h3>
              <p>{chemical.summary}</p>
              <p>{chemical.responsibility}</p>
              <ul class="pills" aria-label="Tecnologías de Chemical Software">{chemical.stack.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
            </div>
            <details class="case-details"><summary>Ver capturas y aporte técnico <span aria-hidden="true">+</span></summary>
              <ProjectGallery images={chemical.gallery ?? []} label="Chemical Software" />
              <ul>{chemical.decisions.map((item) => <li>{item}</li>)}</ul>
              <ActionLink href={chemical.links[0].href} label={chemical.links[0].label} external={chemical.links[0].external} standalone />
            </details>
          </article>
          <article class="project minecall compact-case" aria-labelledby="minecall-title" data-reveal>
            <div class="mine-copy">
              <h3 id="minecall-title">{minecall.title}</h3>
              <p>{minecall.responsibility}</p>
              <ul class="pills" aria-label="Tecnologías de MineCall">{minecall.stack.map((item) => <li>{item}</li>)}</ul>
              <ActionLink href={minecall.links[0].href} label="Ver demo" external={minecall.links[0].external} standalone />
            </div>
            <details class="case-details"><summary>Ver capturas y aporte técnico <span aria-hidden="true">+</span></summary>
              <ProjectGallery images={minecall.gallery ?? []} label="MineCall" />
              <ul>{minecall.decisions.map((item) => <li>{item}</li>)}</ul>
            </details>
          </article>
        </div>

        <section class="specialized" aria-labelledby="specialized-title">
          <header><h2 id="specialized-title">Seguridad y privacidad.</h2></header>
          <div class="specialized-layout">
            <article id="cercaya" class="cercaya" aria-labelledby="cercaya-title" data-project-copy data-reveal>
              <div class="cercaya-intro"><h3 id="cercaya-title">{cercaya.title}</h3>
              <p>{cercaya.summary}</p>
              <p>{cercaya.responsibility}</p></div>

              <div class="cercaya-footer"><ul class="pills">{cercaya.stack.map((item) => <li>{item}</li>)}</ul>
              <ActionLink href={cercaya.links[0].href} label={cercaya.links[0].label} external={cercaya.links[0].external} standalone /></div>
              <details class="special-details"><summary>Ver alcance técnico <span aria-hidden="true">+</span></summary><div class="private-evidence"><h4>Módulo de evidencia</h4><p>Autorización contextual, sanitización de imágenes, integridad SHA-256 y auditoría.</p></div><ul>{cercaya.decisions.map((item) => <li>{item}</li>)}</ul></details>
            </article>
          </div>
        </section>
      </section>

      <section class="others" aria-labelledby="others-title">
        <header><h2 id="others-title">Trabajo complementario.</h2></header>
        <div class="other-grid" data-reveal data-reveal-delay="70">
          <article id="memoriesai" aria-labelledby="memories-title"><h3 id="memories-title">{memories.title}</h3><p>{memories.summary}</p><ul class="pills" aria-label="Tecnologías de MemoriesAI">{memories.stack.slice(0, 4).map((item) => <li>{item}</li>)}</ul><details class="special-details"><summary>Ver decisiones de implementación <span aria-hidden="true">+</span></summary><ul>{memories.decisions.map((item) => <li>{item}</li>)}</ul></details></article>
          {others.map((project) => <article><h3>{project.title}</h3><p>{project.summary}</p><ul class="pills">{project.stack.slice(0, 4).map((item) => <li>{item}</li>)}</ul>{project.links[0] && <ActionLink href={project.links[0].href} label={project.links[0].label} external={project.links[0].external} standalone />}</article>)}
          <article><h3>{datamark.title}</h3><p>{datamark.summary}</p><ul class="pills">{datamark.stack.map((item) => <li>{item}</li>)}</ul></article>
        </div>
      </section>

      <section id="capacidades" class="capabilities" aria-labelledby="capabilities-title">
        <header class="capabilities-heading" data-reveal>
          <h2 id="capabilities-title">Tecnologías y forma de trabajo</h2>
        </header>
        <div class="capabilities-evidence" data-reveal>
          <div class="capabilities-core">
            <h3>Núcleo backend</h3>
            <dl class="core-technologies">
              {capabilities.coreBackend.map((item) => <div><dt>{item.technology}</dt><dd><span>{item.evidence}</span><ActionLink href={item.href} label={item.project} variant="text" /></dd></div>)}
            </dl>
          </div>
          <dl class="technology-groups">
            {capabilities.groups.map((group) => <div><dt>{group.label}</dt><dd><ul class="technology-list" role="list">{group.technologies.map((name) => <li>{name}</li>)}</ul></dd></div>)}
          </dl>
          <p class="capabilities-support">{capabilities.support}</p>
        </div>
        <div class="capabilities-method" data-reveal>
          <div>
            <h3>Discovery y producto</h3>
            <p>Participo en relevamiento y research: alternativas, flujos, casos de uso y casos borde. Continúo con decisiones de producto, arquitectura, implementación, testing y evolución.</p>
          </div>
          <div>
            <h3>Desarrollo con agentes</h3>
            <p>Uso Codex y Claude Code profesionalmente para implementar, revisar y verificar, con alcance claro y evidencia antes de integrar. Mantengo la responsabilidad sobre arquitectura, seguridad y reglas de negocio.</p>
          </div>
        </div>
      </section>

      <section id="experiencia" class="experience" aria-labelledby="experience-title">
        <header><h2 id="experience-title">Trayectoria profesional.</h2></header>
        <div class="experience-list">
          {experience.map((item, index) => <article class:list={[index === 0 && "current"]} data-reveal data-reveal-delay={index === 0 ? "60" : "100"}><time>{item.date}</time><div><h3>{item.role}</h3><p>{item.company}</p></div><p>{item.description}</p></article>)}
        </div>
      </section>

      <section id="contacto" class="contact" aria-labelledby="contact-title">
        <div class="contact-main"><h2 id="contact-title" data-reveal data-reveal-delay="60">Hablemos de una oportunidad Backend / Full Stack.</h2><a class="contact-email" href={links.email.href} data-reveal data-reveal-delay="100">{profile.email} <span aria-hidden="true">↗</span></a></div>
        <div class="contact-meta" data-reveal data-reveal-delay="80"><p>Buenos Aires, Argentina · Remoto LATAM</p><nav aria-label="Redes y CV"><ActionLink href={links.linkedin.href} label="LinkedIn" variant="text" external /><ActionLink href={links.github.href} label="GitHub" variant="text" external /><ActionLink href={profile.cvPath} label="Descargar CV" variant="text" download /></nav></div>
      </section>
    </main>
</BaseLayout>
