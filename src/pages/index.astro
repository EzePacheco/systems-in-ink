---
import "@fontsource-variable/manrope";
import ProjectMedia from "../components/ProjectMedia.astro";
import portrait from "../assets/profile/ezequiel-pacheco.png";
import { capabilities, experience, links, metadata, profile, projects, type Project } from "../data/portfolio.data";

const byId = (id: string) => projects.find((item) => item.id === id) as Project;
const elementos = byId("elementos");
const editor = byId("el-editor-cms");
const minecall = byId("minecall");
const cercaya = byId("cercaya");
const chemical = byId("chemical-software");
const memories = byId("memoriesai");
const others = projects.filter((item) => ![elementos, editor, minecall, cercaya, chemical, memories].some((project) => project.id === item.id));
const external = (value?: boolean) => value ? { target: "_blank", rel: "noopener noreferrer" } : {};
const personSchema = {
  "@context": "https://schema.org", "@type": "Person", name: profile.name,
  url: "https://portfolio-eze-pacheco.vercel.app/", jobTitle: profile.role, email: profile.email,
  address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
  sameAs: [links.linkedin.href, links.github.href],
  knowsAbout: ["Node.js", "TypeScript", "PostgreSQL", "NestJS", "Express", "Go", "Java", "Spring Boot", "React", "Next.js", "Software architecture", "Web application security"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metadata.description} />
    <meta name="keywords" content="Backend Developer, Full Stack Developer, Node.js, TypeScript, PostgreSQL, NestJS, Go, Java, Spring Boot, React, Next.js" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://portfolio-eze-pacheco.vercel.app/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content="https://portfolio-eze-pacheco.vercel.app/" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <meta property="og:image:alt" content="Portfolio profesional de Ezequiel Pacheco" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{metadata.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="#inicio">Ezequiel Pacheco</a>
      <nav aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a><a href="#experiencia">Experiencia</a><a href="#stack">Stack</a><a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cv" href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow" data-hero-reveal style="--reveal-delay: 0ms">Buenos Aires, Argentina · Remote LATAM</p>
          <h1 id="hero-title" data-hero-reveal style="--reveal-delay: 70ms">Backend Developer <em>con alcance Full Stack.</em></h1>
          <p class="lead" data-hero-reveal style="--reveal-delay: 140ms">Diseño y construyo sistemas web end-to-end con Node.js, TypeScript y PostgreSQL: APIs, datos, seguridad, integraciones, testing y operación.</p>
          <p class="secondary" data-hero-reveal style="--reveal-delay: 190ms">Backend también con Go y Java / Spring Boot.</p>
          <div class="actions" data-hero-reveal style="--reveal-delay: 250ms"><a class="button accent" href="#proyectos">Ver proyectos ↓</a><a class="button soft" href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a></div>
        </div>
        <figure class="hero-portrait" data-hero-reveal style="--reveal-delay: 120ms"><img src={portrait.src} width={portrait.width} height={portrait.height} alt="Retrato de Ezequiel Pacheco" fetchpriority="high" /></figure>
        <ul class="core" aria-label="Stack principal" data-hero-reveal style="--reveal-delay: 320ms"><li>Node.js</li><li>TypeScript</li><li>PostgreSQL</li><li>NestJS</li><li>Go</li><li>Java / Spring Boot</li></ul>
      </section>

      <section id="proyectos" class="intro" aria-labelledby="work-title">
        <p class="eyebrow">Trabajo seleccionado</p>
        <div><h2 id="work-title">Productos reales,<br /><em>sistemas que importan.</em></h2><p>Mi trabajo conecta requerimientos, arquitectura, implementación y operación. Estos casos muestran sistemas transaccionales, editoriales, realtime, SaaS y tooling para IA.</p></div>
      </section>

      <article class="project elementos" aria-labelledby="elementos-title">
        <div class="elementos-layout">
          <div class="project-copy" data-project-copy data-reveal>
            <p class="eyebrow">Marketplace B2B/B2C</p><p class="status">{elementos.status}</p><h2 id="elementos-title">Elementos</h2>
            <p>{elementos.summary}</p><p><strong>Mi trabajo:</strong> {elementos.responsibility}</p>
            <ul class="pills"><li>Backend modular</li><li>Pagos y conciliación</li><li>Jobs e idempotencia</li></ul>
            <div class="links">{elementos.links.map((link) => <a href={link.href} {...external(link.external)}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>
          </div>
          <div class="media-area media-area--elementos" data-reveal="media" data-reveal-delay="70"><ProjectMedia src={elementos.media.src} alt={elementos.media.alt} caption={elementos.media.caption} aspect="landscape" fit="contain" position="center top" /><p class="module-count"><strong>30<sup>+</sup></strong><span>módulos de negocio</span></p></div>
        </div>
        <div class="project-band" data-reveal="bar" data-reveal-delay="120">Node.js · Express · PostgreSQL · Sequelize · Umzug <span>Catálogo · Carrito/Stock · Checkout · Pagos · Órdenes</span></div>
        <details><summary>Ver decisiones de ingeniería <span>+</span></summary><ul>{elementos.decisions.map((item) => <li>{item}</li>)}</ul></details>
      </article>

      <article class="project editor" aria-labelledby="editor-title">
        <div class="editor-copy" data-project-copy data-reveal><p class="eyebrow">CMS editorial multitenant + portales públicos</p><p class="status">{editor.status}</p><h2 id="editor-title">El Editor</h2><p>{editor.summary}</p><p><strong>Mi trabajo:</strong> {editor.responsibility}</p><a class="inline" href={editor.links[0].href} {...external(editor.links[0].external)}>{editor.links[0].label} <span aria-hidden="true">↗</span></a></div>
        <div class="editor-media" data-reveal="media" data-reveal-delay="80"><ProjectMedia src={editor.media.src} alt={editor.media.alt} caption={editor.media.caption} aspect="landscape" fit="contain" position="center top" /><div class="future-slot" aria-label="CMS: nueva captura pendiente" data-reveal data-reveal-delay="160"><b>CMS</b><span>Nueva captura pendiente</span></div></div>
        <ul class="pills"><li>Multitenancy</li><li>RBAC</li><li>React CMS</li><li>Next.js / ISR</li><li>S3 / CloudFront</li><li>SEO / analytics</li></ul>
        <details><summary>Ver decisiones de ingeniería <span>+</span></summary><ul>{editor.decisions.map((item) => <li>{item}</li>)}</ul></details>
      </article>

      <article class="project minecall" aria-labelledby="minecall-title">
        <div class="mine-layout">
          <div class="mine-media" data-reveal="media"><ProjectMedia src={minecall.media.src} alt={minecall.media.alt} caption={minecall.media.caption} aspect="wide" fit="cover" position="center" /><p class="mine-media-meta">GO · WEBSOCKETS · REDIS · LIVEKIT · POSTGRESQL</p></div>
          <div class="mine-copy" data-project-copy data-reveal data-reveal-delay="70"><p class="eyebrow">Oficina virtual en tiempo real</p><p class="status">{minecall.status}</p><h2 id="minecall-title">MineCall</h2><p>{minecall.summary}</p><p>{minecall.problem}</p><a class="inline" href={minecall.links[0].href} {...external(minecall.links[0].external)}>Abrir MineCall <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="mine-notes" data-reveal data-reveal-delay="110"><p><b>Arquitectura modular en Go</b><span>pgx/sqlc, Goose, goroutines y channels.</span></p><p><b>Realtime distribuido</b><span>Presence, reconnect/replay, backpressure y Redis Pub/Sub.</span></p><p><b>Operación</b><span>Outbox, adapters de billing, Prometheus y pruebas de carga.</span></p></div>
        <details><summary>Ver decisiones de ingeniería <span>+</span></summary><ul>{minecall.decisions.map((item) => <li>{item}</li>)}</ul></details>
      </article>

      <section class="specialized" aria-labelledby="specialized-title">
        <header data-reveal><p class="eyebrow">Profundidad especializada</p><h2 id="specialized-title">Seguridad, operación<br />y tooling aplicado.</h2></header>
        <div class="special-grid">
          <article class="cercaya" data-reveal><div class="cercaya-copy" data-project-copy><p class="eyebrow">Java / seguridad</p><p class="status">{cercaya.status}</p><h3 id="cercaya-title">Cercaya</h3><p>Marketplace de servicios a domicilio.</p><p>{cercaya.summary}</p><b>Private Evidence Foundation</b><small>Autorización contextual · EXIF stripping · SHA-256 · auditoría</small><a class="inline" href={cercaya.links[0].href}>Pedir caso técnico <span aria-hidden="true">↗</span></a></div><div class="cercaya-media"><ProjectMedia aspect="mobile" placeholder="Cercaya · flujo de solicitud" /></div><ul class="pills"><li>Java</li><li>Spring Boot</li><li>Spring Modulith</li><li>PostgreSQL</li><li>OIDC</li></ul></article>
          <article class="chemical" data-reveal data-reveal-delay="70"><div class="chemical-layout"><div class="chemical-copy" data-project-copy><p class="eyebrow">SaaS + inventario</p><p class="status">{chemical.status}</p><h3 id="chemical-title">Chemical Software</h3><p>{chemical.summary}</p><p class="tenant">Plataforma · comercio · sucursales<br /><b>ADMIN / STAFF</b></p><a class="inline" href={chemical.links[0].href}>Pedir caso técnico <span aria-hidden="true">↗</span></a></div><div class="chemical-media"><ProjectMedia src={chemical.media.src} alt={chemical.media.alt} caption={chemical.media.caption} aspect="landscape" fit="contain" position="center top" /></div></div><ul class="pills"><li>NestJS</li><li>TypeScript</li><li>PostgreSQL</li><li>Inventory</li><li>Audit</li></ul></article>
        </div>
      </section>

      <article class="memories" aria-labelledby="memories-title"><div data-project-copy data-reveal><p class="eyebrow">Herramienta local de investigación aplicada</p><p class="status">{memories.status}</p><h2 id="memories-title">MemoriesAI</h2><p>Memoria durable y verificable para agentes.</p><p>{memories.summary}</p><p class="experimental">El flujo normal es local, determinista y agnóstico al proveedor/modelo. Vector e hybrid retrieval son extensiones experimentales.</p><a class="inline" href={memories.links[0].href}>Pedir caso técnico <span aria-hidden="true">↗</span></a></div><div class="memories-media" data-reveal="media" data-reveal-delay="80"><ProjectMedia aspect="tooling" placeholder="MemoriesAI · retrieval con provenance" /></div><ul class="pills"><li>Python</li><li>BM25</li><li>SQLite / FTS5</li><li>CLI</li></ul></article>

      <section class="others" aria-labelledby="others-title"><header data-reveal><p class="eyebrow">Otros productos</p><h2 id="others-title">También construí.</h2></header><div data-reveal data-reveal-delay="70">{others.map((project) => <article><p class="eyebrow">{project.status}</p><h3>{project.title}</h3><p>{project.summary}</p><ul class="pills">{project.stack.slice(0, 5).map((item) => <li>{item}</li>)}</ul>{project.links[0] && <a class="inline" href={project.links[0].href} {...external(project.links[0].external)}>{project.links[0].label} <span aria-hidden="true">↗</span></a>}</article>)}<article><p class="eyebrow">MVP B2B SaaS</p><h3>DATAMARK</h3><p>MVP B2B SaaS de ventas, inventario, clientes y analítica desarrollado en equipo. Lideré el backend con Node.js, TypeScript, Express, PostgreSQL y Prisma, implementando JWT/RBAC y dashboards.</p><ul class="pills"><li>Node.js</li><li>TypeScript</li><li>Express</li><li>PostgreSQL</li><li>Prisma</li></ul></article></div></section>

      <section id="experiencia" class="experience" aria-labelledby="experience-title"><header data-reveal><p class="eyebrow">Experiencia</p><h2 id="experience-title">Productos, operación<br />y desarrollo.</h2></header><div>{experience.map((item, index) => <article class:list={[index === 0 && "current"]} data-reveal data-reveal-delay={index === 0 ? "80" : "140"}><time>{item.date}</time><p><b>{item.role}</b><span>{item.company}</span></p><p>{item.description}</p></article>)}</div></section>

      <section id="stack" class="stack" aria-labelledby="stack-title"><div data-reveal><p class="eyebrow">Tecnologías con contexto</p><h2 id="stack-title">Mi núcleo es<br /><em>backend.</em></h2><p>Node.js, TypeScript y PostgreSQL son el centro. Go, Java/Spring Boot, Python, React y Next.js acompañan productos concretos.</p></div><aside data-reveal data-reveal-delay="70"><p>Principal</p><b>Node.js<br />TypeScript<br />PostgreSQL<br />NestJS</b></aside><div class="capabilities" data-reveal data-reveal-delay="110">{capabilities.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p><ul>{item.items.map((tech) => <li>{tech}</li>)}</ul></article>)}</div></section>

      <section class="method" aria-labelledby="method-title"><div data-reveal><p class="eyebrow">Forma de trabajo</p><h2 id="method-title">Del problema al sistema que sigue funcionando.</h2></div><div data-reveal data-reveal-delay="80"><p><b>Producto.</b> Entender el flujo antes de implementar. <b>Backend.</b> Diseñar contratos, datos, seguridad y consistencia. <b>Calidad.</b> Probar casos de falla y operar con evidencia.</p><p>Uso Codex y Claude Code para análisis, implementación, testing y review dentro de workflows basados en especificaciones, manteniendo la validación técnica del resultado.</p></div></section>

      <section id="contacto" class="contact" aria-labelledby="contact-title"><p class="eyebrow" data-reveal>Disponible para oportunidades Backend / Full Stack</p><h2 id="contact-title" data-reveal data-reveal-delay="60">Construyamos<br /><em>algo real.</em></h2><p data-reveal data-reveal-delay="100">Buenos Aires, Argentina<br />Remote LATAM / Buenos Aires</p><a href={links.email.href} data-reveal data-reveal-delay="120">{profile.email} <span aria-hidden="true">↗</span></a><nav aria-label="Redes y contacto" data-reveal data-reveal-delay="150"><a href={links.linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={links.github.href} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a></nav></section>
    </main>
    <footer class="footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.footerNote}</span></footer>
    <script is:inline>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const header = document.querySelector(".site-header");
      const syncHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);

      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      if (!prefersReducedMotion.matches && "IntersectionObserver" in window) {
        document.documentElement.classList.add("motion-ready");
        requestAnimationFrame(() => document.querySelector(".hero")?.classList.add("is-visible"));

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );

        document.querySelectorAll("[data-reveal]").forEach((target) => {
          const delay = target.getAttribute("data-reveal-delay");
          if (delay) target.style.setProperty("--reveal-delay", `${delay}ms`);
          revealObserver.observe(target);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root { --ink:#252620; --paper:#f7f6f2; --soft:#ebe9e2; --muted:#62645e; --gold:#dfb431; --gold-deep:#926700; --green:#0d3d35; --mint:#dce8dc; --page:1320px; --g:clamp(20px,5vw,76px); --r:18px; --ease:cubic-bezier(.22,1,.36,1); --motion-fast:180ms; --motion-base:280ms; --motion-reveal:560ms; --section-space-xl:clamp(7rem,9vw,10rem); --section-space-lg:clamp(5rem,7vw,8rem); --section-space-md:clamp(3.5rem,5vw,6rem); --text-display:clamp(3.65rem,3rem + 3vw,6.25rem); --text-h2:clamp(2.35rem,1.95rem + 2vw,4.45rem); --text-h3:clamp(1.55rem,1.3rem + .8vw,2.35rem); --text-lead:clamp(1.05rem,1rem + .25vw,1.25rem); }
  *{box-sizing:border-box} html{background:var(--paper);scroll-behavior:smooth} body{min-width:320px;margin:0;background:var(--paper);color:var(--ink);font-family:"Manrope Variable","Manrope",ui-sans-serif,system-ui,sans-serif;font-weight:450;line-height:1.62} h1,h2,h3,p,ul,figure,figcaption{margin:0} ul{padding:0;list-style:none} a{color:inherit;text-decoration:none} img{display:block;max-width:100%} h1,h2,h3{text-wrap:balance} [id]{scroll-margin-top:86px} :focus-visible{outline:3px solid var(--gold-deep);outline-offset:4px}.skip-link{position:fixed;z-index:99;top:10px;left:10px;padding:10px 14px;background:var(--gold);font-weight:800;transform:translateY(-160%)}.skip-link:focus{transform:none}
  .eyebrow,.status{font-size:clamp(.72rem,.68rem + .15vw,.82rem);font-weight:700;letter-spacing:.055em;text-transform:uppercase}.eyebrow{color:var(--gold-deep)}.status{margin-top:8px;color:var(--muted)}.site-header,.hero,.intro,.project,.specialized,.memories,.others,.experience,.stack,.method,.contact,.footer{width:min(calc(100% - var(--g)*2),var(--page));margin-inline:auto}
  .site-header{position:sticky;z-index:20;top:0;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:76px;background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(12px);transition:min-height var(--motion-base) var(--ease),background-color var(--motion-base) var(--ease),box-shadow var(--motion-base) var(--ease)}.site-header.is-scrolled{min-height:66px;background:color-mix(in srgb,var(--paper) 96%,transparent);box-shadow:0 8px 24px rgba(37,38,32,.055)}.brand{font-size:.82rem;font-weight:800;letter-spacing:-.04em}.site-header nav{display:flex;gap:clamp(15px,2.4vw,34px);font-size:.88rem;font-weight:650}.site-header nav a:hover,.inline:hover,.links a:hover{color:var(--gold-deep)}.header-cv{justify-self:end;padding:10px 14px;border-radius:10px;background:var(--ink);color:var(--paper);font-size:.8rem;font-weight:700}.header-cv span,.inline span,.links a span,.contact a span{display:inline-block;transition:transform var(--motion-fast) var(--ease)}
  .hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.72fr);gap:clamp(40px,8vw,130px);min-height:calc(84svh - 76px);padding-block:clamp(64px,9vw,125px) 44px;align-items:center}.hero h1{max-width:10.5ch;margin-top:18px;font-size:var(--text-display);font-weight:780;letter-spacing:-.075em;line-height:.94}.hero h1 em,.intro h2 em,.stack h2 em,.contact h2 em{display:block;color:#6a6c65;font-style:normal;font-weight:500}.lead{max-width:62ch;margin-top:28px;color:#4e504a;font-size:var(--text-lead);line-height:1.62}.secondary{margin-top:10px;color:var(--gold-deep);font-size:1rem;font-weight:700}.actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 19px;border-radius:10px;font-size:.9rem;font-weight:700;transition:transform .2s var(--ease)}.accent{background:var(--gold);box-shadow:0 13px 25px rgba(170,120,0,.13)}.soft{background:var(--soft)}.hero-portrait{position:relative;min-height:clamp(430px,43vw,610px);margin:0;align-self:stretch;overflow:hidden;border-radius:18px;background:#e3dfd1;box-shadow:0 22px 42px rgba(37,38,32,.13)}.hero-portrait::after{position:absolute;inset:auto 0 0;height:22%;background:linear-gradient(transparent,rgba(37,38,32,.13));content:""}.hero-portrait img{width:100%;height:100%;object-fit:cover;object-position:50% 12%;filter:none}.core{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px 22px;padding-top:10px;color:#575952;font-size:.9rem;font-weight:650}.core li:not(:last-child)::after{margin-left:22px;color:var(--gold-deep);content:"·"}
  .intro{display:grid;grid-template-columns:.52fr 1fr;gap:clamp(34px,9vw,125px);padding-block:var(--section-space-xl) 50px}.intro h2,.specialized h2,.others h2,.experience h2{font-size:var(--text-h2);font-weight:760;letter-spacing:-.065em;line-height:1.02}.intro div>p{max-width:56ch;margin-top:24px;color:var(--muted);font-size:var(--text-lead)}.project{position:relative;margin-top:clamp(56px,8vw,105px);overflow:hidden}.project h2{font-size:clamp(3.15rem,5.5vw,6.35rem);font-weight:780;letter-spacing:-.08em;line-height:.94}.project h3{font-size:var(--text-h3);font-weight:760;letter-spacing:-.06em;line-height:1.02}.project-copy>p:not(.eyebrow):not(.status),.editor-copy>p:not(.eyebrow):not(.status),.mine-copy>p:not(.eyebrow):not(.status),.memories>div>p:not(.eyebrow):not(.status){margin-top:20px}.pills{display:flex;flex-wrap:wrap;gap:8px}.pills li{padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.15);font-size:.79rem;font-weight:650}.links{display:flex;flex-wrap:wrap;gap:17px;margin-top:25px;font-size:.9rem;font-weight:700}.inline{display:inline-block;margin-top:25px;font-size:.9rem;font-weight:700;text-decoration:underline;text-underline-offset:4px}.project details{font-size:.88rem;font-weight:650}.project summary{display:flex;justify-content:space-between;gap:18px;cursor:pointer;list-style:none}.project summary::-webkit-details-marker{display:none}.project details ul{display:grid;gap:9px;margin-top:18px;font-size:.88rem;font-weight:450}.project details li{position:relative;padding-left:15px}.project details li::before{position:absolute;top:.65em;left:0;width:5px;height:5px;border-radius:50%;background:currentColor;content:""}
