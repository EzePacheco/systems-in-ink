<style is:global>
  /* Media is structural: screenshots and their surrounding copy never share a layer. */
  .project > *,
  [data-project-copy],
  [data-project-media],
  .chemical-layout,
  .chemical-copy,
  .chemical-media,
  .cercaya-copy,
  .cercaya-media,
  .memories-media {
    min-width: 0;
  }

  .project-media {
    width: 100%;
    margin: 0;
    overflow: visible;
    background: transparent;
    aspect-ratio: auto;
  }

  .project-media__frame {
    position: relative;
    width: 100%;
    overflow: clip;
    border-radius: inherit;
    background: rgba(30, 31, 27, 0.08);
    aspect-ratio: var(--media-ratio, 16 / 10);
  }

  .project-media img,
  .project-media__placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .project-media figcaption {
    position: static;
    min-height: 0;
    margin-top: 10px;
    padding: 0;
    color: inherit;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.45;
    text-shadow: none;
  }

  .project-media__placeholder {
    display: grid;
    place-content: center;
  }

  .elementos {
    container-name: elementos;
    display: block;
  }

  .elementos h2 {
    font-size: clamp(3rem, 6cqi, 5.4rem);
  }

  .elementos-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
  }

  .media-area {
    position: static;
    min-height: 0;
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .media-area .project-media {
    height: auto;
  }

  .media-area .project-media__frame {
    background: #11120f;
  }

  .module-count {
    position: static;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    color: #fff8e3;
    text-shadow: none;
  }

  .module-count strong {
