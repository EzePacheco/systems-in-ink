---
import "@fontsource-variable/manrope";
import ProjectMedia from "../components/ProjectMedia.astro";
import portrait from "../assets/profile/ezequiel-pacheco.png";
import "../styles/portfolio.css";
import { experience, links, metadata, profile, projects, type Project } from "../data/portfolio.data";

const byId = (id: string) => projects.find((item) => item.id === id) as Project;
const elementos = byId("elementos");
const editor = byId("el-editor-cms");
const minecall = byId("minecall");
const cercaya = byId("cercaya");
const chemical = byId("chemical-software");
const memories = byId("memoriesai");
const others = projects.filter((item) => ![elementos, editor, minecall, cercaya, chemical, memories].some((project) => project.id === item.id));
const external = (value?: boolean) => value ? { target: "_blank", rel: "noopener noreferrer" } : {};
const personSchema = {
  "@context": "https://schema.org", "@type": "Person", name: profile.name,
  url: "https://portfolio-eze-pacheco.vercel.app/", jobTitle: profile.role, email: profile.email,
  address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
  sameAs: [links.linkedin.href, links.github.href],
  knowsAbout: ["Node.js", "TypeScript", "PostgreSQL", "NestJS", "Express", "Go", "Java", "Spring Boot", "React", "Next.js", "Software architecture", "Web application security"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metadata.description} />
    <meta name="keywords" content="Backend Developer, Full Stack Developer, Node.js, TypeScript, PostgreSQL, NestJS, Go, Java, Spring Boot, React, Next.js" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://portfolio-eze-pacheco.vercel.app/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content="https://portfolio-eze-pacheco.vercel.app/" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <meta property="og:image:alt" content="Portfolio profesional de Ezequiel Pacheco" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <title>{metadata.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="#inicio">Ezequiel Pacheco</a>
      <nav aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a>
        <a href="#capacidades">Capacidades</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cv" href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow" data-hero-reveal style="--reveal-delay: 0ms">Buenos Aires, Argentina · Remote LATAM</p>
          <h1 id="hero-title" data-hero-reveal style="--reveal-delay: 70ms">Backend Developer <em>con alcance Full Stack.</em></h1>
          <p class="lead" data-hero-reveal style="--reveal-delay: 140ms">Diseño y construyo sistemas web end-to-end con Node.js, TypeScript y PostgreSQL: APIs, datos, seguridad, integraciones, testing y operación.</p>
          <p class="secondary" data-hero-reveal style="--reveal-delay: 190ms">Backend también con Go y Java / Spring Boot.</p>
          <div class="actions" data-hero-reveal style="--reveal-delay: 250ms"><a class="button accent" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a><a class="button soft" href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a></div>
        </div>
        <figure class="hero-portrait" data-hero-reveal style="--reveal-delay: 120ms"><img src={portrait.src} width={portrait.width} height={portrait.height} alt="Retrato de Ezequiel Pacheco" fetchpriority="high" /></figure>
        <ul class="core" aria-label="Stack principal y ecosistemas backend" data-hero-reveal style="--reveal-delay: 320ms"><li>Node.js</li><li>TypeScript</li><li>PostgreSQL</li><li>NestJS</li><li>Go</li><li>Java / Spring Boot</li></ul>
      </section>

      <section id="proyectos" class="selected-work" aria-labelledby="work-title">
        <header class="work-intro" data-reveal>
          <p class="eyebrow">Trabajo seleccionado</p>
          <div>
            <h2 id="work-title">Productos reales, sistemas que importan.</h2>
            <p>Requerimientos, arquitectura, implementación y operación en sistemas transaccionales, editoriales, realtime y tooling.</p>
          </div>
        </header>

        <article class="project elementos" aria-labelledby="elementos-title">
          <div class="elementos-layout">
            <div class="project-copy" data-project-copy data-reveal>
              <p class="eyebrow">Marketplace B2B/B2C · {elementos.status}</p>
              <h3 id="elementos-title">Elementos</h3>
              <p>{elementos.summary}</p>
              <p>{elementos.responsibility}</p>
              <ul class="project-points"><li>Consistencia transaccional</li><li>Pagos e integraciones</li><li>Jobs y operación</li></ul>
              <div class="links">{elementos.links.map((link) => <a href={link.href} {...external(link.external)}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>
            </div>
            <div class="elementos-media" data-project-media data-reveal="media" data-reveal-delay="70"><ProjectMedia src={elementos.media?.src} alt={elementos.media?.alt ?? ""} aspect="native" fit="contain" position="center top" priority /></div>
          </div>
          <details><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{elementos.decisions.map((item) => <li>{item}</li>)}</ul></details>
        </article>

        <article class="project editor" aria-labelledby="editor-title">
          <div class="editor-layout">
            <div class="editor-copy" data-project-copy data-reveal>
              <p class="eyebrow">{editor.status}</p>
              <h3 id="editor-title">El Editor</h3>
              <p>{editor.summary}</p>
              <p>{editor.responsibility}</p>
              <div class="links">{editor.links.map((link) => <a href={link.href} {...external(link.external)}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>
              <ul class="pills"><li>Multitenancy</li><li>RBAC</li><li>React CMS</li><li>Next.js / ISR</li><li>S3 / CloudFront</li><li>SEO / analytics</li></ul>
            </div>
            <div class="editor-media" data-project-media data-reveal="media" data-reveal-delay="80"><ProjectMedia src={editor.media?.src} alt={editor.media?.alt ?? ""} aspect="native" fit="contain" position="center top" /></div>
          </div>
          <details><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{editor.decisions.map((item) => <li>{item}</li>)}</ul></details>
        </article>

        <article class="project minecall" aria-labelledby="minecall-title">
          <div class="mine-layout">
            <div class="mine-media" data-project-media data-reveal="media"><ProjectMedia src={minecall.media?.src} alt={minecall.media?.alt ?? ""} aspect="wide" fit="cover" position="center" /><p class="mine-media-meta">Go · PostgreSQL · WebSockets · Redis · LiveKit</p></div>
            <div class="mine-copy" data-project-copy data-reveal data-reveal-delay="70">
              <p class="eyebrow">Oficina virtual en tiempo real · {minecall.status}</p>
              <h3 id="minecall-title">MineCall</h3>
              <p>{minecall.summary}</p><p>{minecall.problem}</p>
              <a class="inline" href={minecall.links[0].href} {...external(minecall.links[0].external)}>Abrir MineCall <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="mine-notes" data-reveal data-reveal-delay="110"><p><b>Arquitectura modular en Go</b><span>pgx/sqlc, Goose, goroutines y channels.</span></p><p><b>Realtime distribuido</b><span>Presence, reconnect/replay, backpressure y Redis Pub/Sub.</span></p><p><b>Operación</b><span>Outbox, adapters de billing, Prometheus y pruebas de carga.</span></p></div>
          <details><summary>Ver decisiones de ingeniería <span aria-hidden="true">+</span></summary><ul>{minecall.decisions.map((item) => <li>{item}</li>)}</ul></details>
        </article>

        <section class="specialized" aria-labelledby="specialized-title">
          <header><p class="eyebrow">Casos especializados</p><h2 id="specialized-title">Seguridad, operación y producto.</h2></header>
          <article id="chemical-software" class="chemical" aria-labelledby="chemical-title">
            <div class="chemical-layout">
              <div class="chemical-media" data-project-media data-reveal="media"><ProjectMedia src={chemical.media?.src} alt={chemical.media?.alt ?? ""} aspect="native" fit="contain" position="center top" /></div>
              <div class="chemical-copy" data-project-copy data-reveal>
                <p class="eyebrow">{chemical.status}</p><h3 id="chemical-title">Chemical Software</h3>
                <p>{chemical.summary}</p><p>{chemical.responsibility}</p>
                <ul class="pills"><li>NestJS</li><li>PostgreSQL</li><li>TypeORM</li></ul>
                <a class="inline" href={chemical.links[0].href} {...external(chemical.links[0].external)}>{chemical.links[0].label} <span aria-hidden="true">↗</span></a>
              </div>
            </div>
            <details class="special-details"><summary>Ver alcance técnico <span aria-hidden="true">+</span></summary><ul>{chemical.decisions.map((item) => <li>{item}</li>)}</ul></details>
          </article>
          <div class="special-pair">
            <article id="cercaya" class="cercaya" aria-labelledby="cercaya-title" data-project-copy data-reveal>
              <p class="eyebrow">Java / seguridad · {cercaya.status}</p><h3 id="cercaya-title">Cercaya</h3>
              <p>{cercaya.summary}</p>
              <p>{cercaya.responsibility}</p>
              <div class="private-evidence"><h4>Evidencia privada</h4><p>Autorización contextual, sanitización de imágenes, integridad SHA-256 y auditoría. Implementación limitada a datos sintéticos.</p></div>
              <ul class="pills"><li>Java / Spring Boot</li><li>Spring Modulith</li><li>PostgreSQL</li><li>OIDC</li></ul>
              <a class="inline" href={cercaya.links[0].href} {...external(cercaya.links[0].external)}>{cercaya.links[0].label} <span aria-hidden="true">↗</span></a>
              <details class="special-details"><summary>Ver alcance técnico <span aria-hidden="true">+</span></summary><ul>{cercaya.decisions.map((item) => <li>{item}</li>)}</ul></details>
            </article>
            <article id="memoriesai" class="memories" aria-labelledby="memories-title" data-reveal>
              <div class="memories-intro" data-project-copy>
                <p class="eyebrow">Herramienta interna · Python</p><h3 id="memories-title">MemoriesAI</h3>
                <p>{memories.summary}</p>
              </div>
              <dl class="memories-capabilities">
                <div><dt>Recuperación BM25</dt><dd>Búsqueda por secciones y alcance de proyecto.</dd></div>
                <div><dt>Ciclo de vida</dt><dd>Revisión, reemplazo y archivo de conocimiento.</dd></div>
                <div><dt>Contexto verificable</dt><dd>Fragmentos acotados con origen identificable.</dd></div>
                <div><dt>Persistencia local</dt><dd>Markdown como fuente e índices SQLite reconstruibles.</dd></div>
              </dl>
              <ul class="pills"><li>Python</li><li>BM25</li><li>SQLite</li><li>CLI</li></ul>
              <details class="special-details memories-details"><summary>Ver decisiones de implementación <span aria-hidden="true">+</span></summary><ul>{memories.decisions.map((item) => <li>{item}</li>)}</ul></details>
            </article>
          </div>
        </section>
      </section>

      <section class="others" aria-labelledby="others-title">
        <header><p class="eyebrow">Otros proyectos</p><h2 id="others-title">Trabajo complementario.</h2></header>
        <div class="other-grid" data-reveal data-reveal-delay="70">
          {others.map((project) => <article><p class="eyebrow">{project.status}</p><h3>{project.title}</h3><p>{project.summary}</p><ul class="pills">{project.stack.slice(0, 4).map((item) => <li>{item}</li>)}</ul>{project.links[0] && <a class="inline" href={project.links[0].href} {...external(project.links[0].external)}>{project.links[0].label} <span aria-hidden="true">↗</span></a>}</article>)}
          <article><p class="eyebrow">MVP B2B SaaS</p><h3>DATAMARK</h3><p>MVP B2B SaaS de ventas, inventario, clientes y analítica desarrollado en equipo. Lideré el backend con Node.js, TypeScript, Express, PostgreSQL y Prisma, implementando JWT/RBAC y dashboards.</p><ul class="pills"><li>Node.js</li><li>TypeScript</li><li>Express</li><li>PostgreSQL</li><li>Prisma</li></ul></article>
        </div>
      </section>

      <section id="capacidades" class="capabilities" aria-labelledby="capabilities-title">
        <header class="capabilities-intro" data-reveal>
          <p class="eyebrow">Capacidades con evidencia</p><h2 id="capabilities-title">Tecnologías aplicadas en productos reales.</h2>
          <p>Mi núcleo es Node.js, TypeScript y PostgreSQL. También desarrollo con Go y Java/Spring Boot, e integro interfaces con React y Next.js.</p>
          <p>Trabajo desde el relevamiento y diseño hasta implementación, pruebas y operación; uso Codex y Claude Code con especificaciones y validación técnica humana.</p>
        </header>
        <div class="capabilities-evidence" data-reveal data-reveal-delay="70">
          <dl>
            <div><dt>Node.js / TypeScript</dt><dd>Node.js en Elementos y El Editor; TypeScript con NestJS en Chemical Software.</dd></div>
            <div><dt>PostgreSQL</dt><dd>Modelado, migraciones, transacciones, índices y control de concurrencia en mis proyectos backend.</dd></div>
            <div><dt>Go</dt><dd>MineCall: WebSockets, coordinación con Redis e integración con LiveKit.</dd></div>
            <div><dt>Java / Spring Boot</dt><dd>Cercaya: backend modular, OIDC, privacidad e integración transaccional.</dd></div>
            <div><dt>React / Next.js</dt><dd>CMS, portales y flujos completos de producto, especialmente en El Editor.</dd></div>
            <div><dt>Python</dt><dd>MemoriesAI: scripts, recuperación de contexto y memoria durable.</dd></div>
          </dl>
          <p class="capabilities-support">Testing, autenticación y permisos, Docker, GitHub Actions, integración de S3/CloudFront, métricas, tracing, health/readiness y flujos de ingeniería asistidos por IA.</p>
        </div>
      </section>

      <section id="experiencia" class="experience" aria-labelledby="experience-title">
        <header><p class="eyebrow">Experiencia</p><h2 id="experience-title">Trayectoria profesional.</h2></header>
        <div class="experience-list">
          {experience.map((item, index) => <article class:list={[index === 0 && "current"]} data-reveal data-reveal-delay={index === 0 ? "60" : "100"}><time>{item.date}</time><div><h3>{item.role}</h3><p>{item.company}</p></div><p>{item.description}</p></article>)}
        </div>
      </section>

      <section id="contacto" class="contact" aria-labelledby="contact-title">
        <div class="contact-main"><p class="eyebrow" data-reveal>Disponible para oportunidades Backend / Full Stack</p><h2 id="contact-title" data-reveal data-reveal-delay="60">Construyamos algo real.</h2><a class="contact-email" href={links.email.href} data-reveal data-reveal-delay="100">{profile.email} <span aria-hidden="true">↗</span></a></div>
        <div class="contact-meta" data-reveal data-reveal-delay="80"><p>Buenos Aires, Argentina</p><p>Remoto LATAM / Buenos Aires</p><nav aria-label="Redes y CV"><a href={links.linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={links.github.href} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={profile.cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a></nav></div>
      </section>
    </main>

    <footer class="footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.footerNote}</span></footer>
    <script is:inline>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const header = document.querySelector(".site-header");
      const syncHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      if (!reducedMotion && "IntersectionObserver" in window) {
        document.documentElement.classList.add("motion-ready");
        requestAnimationFrame(() => document.querySelector(".hero")?.classList.add("is-visible"));
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });

        document.querySelectorAll("[data-reveal]").forEach((target) => {
          const delay = target.getAttribute("data-reveal-delay");
          if (delay) target.style.setProperty("--reveal-delay", `${delay}ms`);
          if (target.getBoundingClientRect().top <= window.innerHeight * 0.92) {
            target.classList.add("is-visible");
            return;
          }
          revealObserver.observe(target);
        });
      }
    </script>
  </body>
</html>
