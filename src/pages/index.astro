---
import "@fontsource-variable/ibm-plex-sans";
import portrait from "../assets/profile/ezequiel-pacheco.png";
import { capabilities, experience, links, metadata, profile, projects, type Project } from "../data/portfolio.data";
const byId = (id: string) => projects.find((item) => item.id === id) as Project;
const elementos = byId("elementos"), editor = byId("el-editor-cms"), minecall = byId("minecall"), cercaya = byId("cercaya"), chemical = byId("chemical-software"), memories = byId("memoriesai");
const others = projects.filter((item) => ![elementos, editor, minecall, cercaya, chemical, memories].some((project) => project.id === item.id));
const external = (value?: boolean) => value ? { target: "_blank", rel: "noopener noreferrer" } : {};
const personSchema = { "@context":"https://schema.org", "@type":"Person", name:profile.name, url:"https://portfolio-eze-pacheco.vercel.app/", jobTitle:profile.role, email:profile.email, address:{"@type":"PostalAddress",addressLocality:"Buenos Aires",addressCountry:"AR"}, sameAs:[links.linkedin.href,links.github.href], knowsAbout:["Node.js","TypeScript","PostgreSQL","NestJS","Express","Go","Java","Spring Boot","React","Next.js","Software architecture","Web application security"] };
---
<!doctype html><html lang="es"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={metadata.description} /><meta name="keywords" content="Backend Developer, Full Stack Developer, Node.js, TypeScript, PostgreSQL, NestJS, Go, Java, Spring Boot, React, Next.js" /><meta name="theme-color" content="#f7f6f2" /><meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://portfolio-eze-pacheco.vercel.app/" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" /><meta property="og:locale" content="es_AR" /><meta property="og:url" content="https://portfolio-eze-pacheco.vercel.app/" /><meta property="og:title" content={metadata.title} /><meta property="og:description" content={metadata.description} /><meta property="og:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" /><meta property="og:image:alt" content="Portfolio profesional de Ezequiel Pacheco" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={metadata.title} /><meta name="twitter:description" content={metadata.description} /><meta name="twitter:image" content="https://portfolio-eze-pacheco.vercel.app/portfolio-social.jpg" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script><title>{metadata.title}</title>
</head><body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header"><a class="brand" href="#inicio">Ezequiel<br />Pacheco</a><nav aria-label="Navegación principal"><a href="#proyectos">Proyectos</a><a href="#experiencia">Experiencia</a><a href="#stack">Stack</a><a href="#contacto">Contacto</a></nav><a class="header-cv" href={profile.cvPath} download>Descargar CV ↗</a></header>
<main id="contenido">
  <section id="inicio" class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">Buenos Aires, Argentina · Remote LATAM</p><h1 id="hero-title">Backend Developer <em>con alcance Full Stack.</em></h1><p class="lead">Diseño y construyo sistemas web end-to-end con Node.js, TypeScript y PostgreSQL: APIs, datos, seguridad, integraciones, testing y operación.</p><p class="secondary">Backend también con Go y Java / Spring Boot.</p><div class="actions"><a class="button accent" href="#proyectos">Ver proyectos ↓</a><a class="button soft" href={profile.cvPath} download>Descargar CV ↗</a></div></div><div class="hero-visual"><i class="orbit a" aria-hidden="true"></i><i class="orbit b" aria-hidden="true"></i><span>NODE · TYPESCRIPT<br />POSTGRESQL</span><img src={portrait.src} width={portrait.width} height={portrait.height} alt="Ezequiel Pacheco" fetchpriority="high" /><b>Backend<br />Full Stack</b></div><ul class="core"><li>Node.js</li><li>TypeScript</li><li>PostgreSQL</li><li>NestJS</li><li>Go</li><li>Java / Spring Boot</li></ul></section>
  <section id="proyectos" class="intro" aria-labelledby="work-title"><p class="eyebrow">Trabajo seleccionado</p><div><h2 id="work-title">Productos reales,<br /><em>sistemas que importan.</em></h2><p>Mi trabajo conecta requerimientos, arquitectura, implementación y operación. Estos casos muestran sistemas transaccionales, editoriales, realtime, SaaS y tooling para IA.</p></div></section>
  <article class="project elementos" aria-labelledby="elementos-title"><div class="project-copy"><p class="eyebrow">Marketplace B2B/B2C</p><p class="status">{elementos.status}</p><h2 id="elementos-title">Elementos</h2><p>{elementos.summary}</p><p><strong>Mi trabajo:</strong> {elementos.responsibility}</p><ul class="pills"><li>Backend modular</li><li>Pagos y conciliación</li><li>Jobs e idempotencia</li></ul><div class="links">{elementos.links.map((link) => <a href={link.href} {...external(link.external)}>{link.label} ↗</a>)}</div></div><figure class="media"><img src={elementos.media.src.src} width={elementos.media.src.width} height={elementos.media.src.height} alt={elementos.media.alt} loading="lazy" /><figcaption>{elementos.media.caption}</figcaption><strong>30<sup>+</sup><small>módulos<br />de negocio</small></strong></figure><div class="project-band">Node.js · Express · PostgreSQL · Sequelize · Umzug <span>Catálogo · Carrito/Stock · Checkout · Pagos · Órdenes</span></div><details><summary>Ver decisiones de ingeniería <span>+</span></summary><ul>{elementos.decisions.map((item) => <li>{item}</li>)}</ul></details></article>
  <article class="project editor" aria-labelledby="editor-title"><div class="editor-copy"><p class="eyebrow">CMS editorial multitenant + portales públicos</p><p class="status">{editor.status}</p><h2 id="editor-title">El Editor</h2><p>{editor.summary}</p><p><strong>Mi trabajo:</strong> {editor.responsibility}</p><a class="inline" href={editor.links[0].href} {...external(editor.links[0].external)}>{editor.links[0].label} ↗</a></div><div class="collage"><figure><img src={editor.media.src.src} width={editor.media.src.width} height={editor.media.src.height} alt={editor.media.alt} loading="lazy" /></figure><p class="cms">React CMS <small>workflow · media · RBAC</small></p><p class="portals">Next.js portals <small>ISR · SEO · WebSub</small></p><b>Una operación editorial,<br />múltiples salidas públicas.</b></div><ul class="pills"><li>Multitenancy</li><li>RBAC</li><li>React CMS</li><li>Next.js / ISR</li><li>S3 / CloudFront</li><li>SEO / analytics</li></ul><details><summary>Ver decisiones de ingeniería <span>+</span></summary><ul>{editor.decisions.map((item) => <li>{item}</li>)}</ul></details></article>
  <article class="project minecall" aria-labelledby="minecall-title"><div class="mine-media"><img src={minecall.media.src.src} width={minecall.media.src.width} height={minecall.media.src.height} alt={minecall.media.alt} loading="lazy" /><p>GO · WEBSOCKETS · REDIS · LIVEKIT · POSTGRESQL</p></div><div class="mine-copy"><p class="eyebrow">Oficina virtual en tiempo real</p><p class="status">{minecall.status}</p><h2 id="minecall-title">MineCall</h2><p>{minecall.summary}</p><p>{minecall.problem}</p><a class="inline" href={minecall.links[0].href} {...external(minecall.links[0].external)}>Abrir MineCall ↗</a></div><div class="mine-notes"><p><b>Arquitectura modular en Go</b><span>pgx/sqlc, Goose, goroutines y channels.</span></p><p><b>Realtime distribuido</b><span>Presence, reconnect/replay, backpressure y Redis Pub/Sub.</span></p><p><b>Operación</b><span>Outbox, adapters de billing, Prometheus y pruebas de carga.</span></p></div><details><summary>Ver decisiones de ingeniería <span>+</span></summary><ul>{minecall.decisions.map((item) => <li>{item}</li>)}</ul></details></article>
  <section class="specialized" aria-labelledby="specialized-title"><header><p class="eyebrow">Profundidad especializada</p><h2 id="specialized-title">Seguridad, operación<br />y tooling aplicado.</h2></header><div class="special-grid"><article class="cercaya"><div><p class="eyebrow">Java / seguridad</p><p class="status">{cercaya.status}</p><h3>Cercaya</h3><p>Marketplace de servicios a domicilio.</p><p>{cercaya.summary}</p><b>Private Evidence Foundation</b><small>Autorización contextual · EXIF stripping · SHA-256 · auditoría</small><a class="inline" href={cercaya.links[0].href}>Pedir caso técnico ↗</a></div><img src={cercaya.media.src.src} width={cercaya.media.src.width} height={cercaya.media.src.height} alt={cercaya.media.alt} loading="lazy" /><ul class="pills"><li>Java</li><li>Spring Boot</li><li>Spring Modulith</li><li>PostgreSQL</li><li>OIDC</li></ul></article><article class="chemical"><img src={chemical.media.src.src} width={chemical.media.src.width} height={chemical.media.src.height} alt={chemical.media.alt} loading="lazy" /><div><p class="eyebrow">SaaS + inventario</p><p class="status">{chemical.status}</p><h3>Chemical Software</h3><p>{chemical.summary}</p><p class="tenant">Plataforma · comercio · sucursales<br /><b>ADMIN / STAFF</b></p><a class="inline" href={chemical.links[0].href}>Pedir caso técnico ↗</a></div><ul class="pills"><li>NestJS</li><li>TypeScript</li><li>PostgreSQL</li><li>Inventory</li><li>Audit</li></ul></article></div></section>
  <article class="memories" aria-labelledby="memories-title"><div><p class="eyebrow">Herramienta local de investigación aplicada</p><p class="status">{memories.status}</p><h2 id="memories-title">MemoriesAI</h2><p>Memoria durable y verificable para agentes.</p><p>{memories.summary}</p><p class="experimental">El flujo normal es local, determinista y agnóstico al proveedor/modelo. Vector e hybrid retrieval son extensiones experimentales.</p><a class="inline" href={memories.links[0].href}>Pedir caso técnico ↗</a></div><figure><img src={memories.media.src.src} width={memories.media.src.width} height={memories.media.src.height} alt={memories.media.alt} loading="lazy" /><figcaption>Markdown → lifecycle → BM25 → contexto acotado → agente</figcaption></figure><ul class="pills"><li>Python</li><li>BM25</li><li>SQLite / FTS5</li><li>CLI</li></ul></article>
  <section class="others" aria-labelledby="others-title"><header><p class="eyebrow">Otros productos</p><h2 id="others-title">También construí.</h2></header><div>{others.map((project) => <article><p class="eyebrow">{project.status}</p><h3>{project.title}</h3><p>{project.summary}</p><ul class="pills">{project.stack.slice(0,5).map((item) => <li>{item}</li>)}</ul>{project.links[0] && <a class="inline" href={project.links[0].href} {...external(project.links[0].external)}>{project.links[0].label} ↗</a>}</article>)}<article><p class="eyebrow">MVP B2B SaaS</p><h3>DATAMARK</h3><p>MVP B2B SaaS de ventas, inventario, clientes y analítica desarrollado en equipo. Lideré el backend con Node.js, TypeScript, Express, PostgreSQL y Prisma, implementando JWT/RBAC y dashboards.</p><ul class="pills"><li>Node.js</li><li>TypeScript</li><li>Express</li><li>PostgreSQL</li><li>Prisma</li></ul></article></div></section>
  <section id="experiencia" class="experience" aria-labelledby="experience-title"><header><p class="eyebrow">Experiencia</p><h2 id="experience-title">Productos, operación<br />y desarrollo.</h2></header><div>{experience.map((item,index) => <article class:list={[index===0 && "current"]}><time>{item.date}</time><p><b>{item.role}</b><span>{item.company}</span></p><p>{item.description}</p></article>)}</div></section>
  <section id="stack" class="stack" aria-labelledby="stack-title"><div><p class="eyebrow">Tecnologías con contexto</p><h2 id="stack-title">Mi núcleo es<br /><em>backend.</em></h2><p>Node.js, TypeScript y PostgreSQL son el centro. Go, Java/Spring Boot, Python, React y Next.js acompañan productos concretos.</p></div><aside><p>Principal</p><b>Node.js<br />TypeScript<br />PostgreSQL<br />NestJS</b></aside><div class="capabilities">{capabilities.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p><ul>{item.items.map((tech) => <li>{tech}</li>)}</ul></article>)}</div></section>
  <section class="method" aria-labelledby="method-title"><div><p class="eyebrow">Forma de trabajo</p><h2 id="method-title">Del problema al sistema que sigue funcionando.</h2></div><div><p><b>Producto.</b> Entender el flujo antes de implementar. <b>Backend.</b> Diseñar contratos, datos, seguridad y consistencia. <b>Calidad.</b> Probar casos de falla y operar con evidencia.</p><p>Uso Codex y Claude Code para análisis, implementación, testing y review dentro de workflows basados en especificaciones, manteniendo la validación técnica del resultado.</p></div></section>
  <section id="contacto" class="contact" aria-labelledby="contact-title"><p class="eyebrow">Disponible para oportunidades Backend / Full Stack</p><h2 id="contact-title">Construyamos<br /><em>algo real.</em></h2><p>Buenos Aires, Argentina<br />Remote LATAM / Buenos Aires</p><a href={links.email.href}>{profile.email} ↗</a><nav aria-label="Redes y contacto"><a href={links.linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={links.github.href} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.cvPath} download>Descargar CV ↗</a></nav></section>
</main><footer class="footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.footerNote}</span></footer></body></html>
<style is:global>
:root{--ink:#252620;--paper:#f7f6f2;--soft:#ebe9e2;--muted:#64665f;--gold:#dfb431;--gold-deep:#a97800;--green:#0d3d35;--mint:#a9e7d3;--page:1240px;--g:clamp(20px,5vw,76px);--r:22px;--ease:cubic-bezier(.2,.75,.25,1)}*{box-sizing:border-box}html{background:var(--paper);scroll-behavior:smooth}body{min-width:320px;margin:0;background:var(--paper);color:var(--ink);font-family:"IBM Plex Sans Variable","IBM Plex Sans",Arial,sans-serif;line-height:1.55}h1,h2,h3,p,ul,figure,figcaption{margin:0}ul{padding:0;list-style:none}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}h1,h2,h3{text-wrap:balance}[id]{scroll-margin-top:86px}:focus-visible{outline:3px solid var(--gold-deep);outline-offset:4px}.skip-link{position:fixed;z-index:99;top:10px;left:10px;padding:10px;background:var(--gold);font-weight:800;transform:translateY(-160%)}.skip-link:focus{transform:none}.eyebrow,.status{font-size:.7rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.eyebrow{color:var(--gold-deep)}.status{margin-top:7px;color:var(--muted)}.site-header,.hero,.intro,.project,.specialized,.memories,.others,.experience,.stack,.method,.contact,.footer{width:min(calc(100% - var(--g)*2),var(--page));margin-inline:auto}.site-header{position:sticky;z-index:20;top:0;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:76px;background:color-mix(in srgb,var(--paper) 90%,transparent);backdrop-filter:blur(14px)}.brand{font-size:.75rem;font-weight:800;line-height:1.02;text-transform:uppercase}.site-header nav{display:flex;gap:clamp(15px,2.4vw,34px);font-size:.83rem;font-weight:700}.site-header nav a:hover,.inline:hover,.links a:hover{color:var(--gold-deep)}.header-cv{justify-self:end;padding:10px 14px;border-radius:999px;background:var(--ink);color:var(--paper);font-size:.78rem;font-weight:800}.hero{display:grid;grid-template-columns:1.08fr .72fr;gap:clamp(30px,7vw,100px);min-height:calc(90svh - 76px);padding-block:clamp(60px,8vw,110px) 45px;align-items:center;overflow:clip}.hero h1{max-width:10ch;margin-top:18px;font-size:clamp(3.4rem,5.8vw,6.3rem);font-weight:720;letter-spacing:-.08em;line-height:.88}.hero h1 em,.intro h2 em,.stack h2 em,.contact h2 em{display:block;color:#6a6c65;font-style:normal;font-weight:370}.lead{max-width:63ch;margin-top:30px;color:#4d5049;font-size:clamp(1rem,1.35vw,1.17rem)}.secondary{margin-top:9px;color:var(--gold-deep);font-weight:700}.actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:29px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 19px;border-radius:12px;font-size:.88rem;font-weight:800;transition:transform .2s var(--ease)}.button:hover{transform:translateY(-3px)}.accent{background:var(--gold);box-shadow:0 13px 25px rgba(170,120,0,.16)}.soft{background:var(--soft)}.hero-visual{position:relative;min-height:450px;border-radius:42% 42% 18px 18px;background:linear-gradient(145deg,#ecd999 4%,var(--gold) 54%,#d98e20);overflow:hidden;box-shadow:0 26px 45px rgba(79,61,15,.18);isolation:isolate}.hero-visual img{position:absolute;z-index:2;right:-7%;bottom:-13%;width:108%;height:106%;object-fit:cover;object-position:50% 15%;mix-blend-mode:multiply;filter:contrast(1.04) saturate(.88)}.hero-visual::after{position:absolute;z-index:3;inset:auto 0 0;height:35%;background:linear-gradient(transparent,rgba(42,36,15,.25));content:""}.hero-visual span,.hero-visual b{position:absolute;z-index:4;color:#382b09;font-size:.67rem;line-height:1.3;letter-spacing:.08em}.hero-visual span{top:32px;left:30px}.hero-visual b{right:24px;bottom:24px;text-align:right}.orbit{position:absolute;z-index:1;border:1px solid rgba(255,255,255,.52);border-radius:50%}.orbit.a{top:16%;right:-30%;width:115%;height:46%;transform:rotate(-25deg)}.orbit.b{bottom:23%;left:-27%;width:75%;height:32%;transform:rotate(28deg)}.core{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px 22px;padding-top:15px;color:#5b5d56;font-size:.84rem;font-weight:700}.core li:not(:last-child)::after{margin