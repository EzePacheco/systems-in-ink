---
import '@fontsource-variable/manrope';
import '@fontsource-variable/ibm-plex-sans';
import '../styles/global.css';
import type { Locale } from '../data/portfolio.data';

type Props = {
  locale: Locale;
  title: string;
  description: string;
  ogImage: string;
  alternatePath: string;
  printable?: boolean;
};

const { locale, title, description, ogImage, alternatePath, printable = false } = Astro.props;
---

<!doctype html>
<html lang={locale === 'es' ? 'es-AR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5eddf" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={alternatePath} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={{ printable }}>
    <slot />
  </body>
</html>
