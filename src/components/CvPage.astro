---
import { socialLinks, type PortfolioContent } from '../data/portfolio.data';

type Props = { content: PortfolioContent };
const { content } = Astro.props;
const { locale, profile, labels } = content;
---

<main id="main" class="cv-page">
  <header class="cv-header">
    <div><p class="kicker">{profile.role}</p><h1>{profile.name}</h1><p>{profile.hero}</p></div>
    <address><span>{profile.location}</span><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={socialLinks.linkedin}>LinkedIn</a><a href={socialLinks.github}>GitHub</a></address>
  </header>
  <section class="cv-section"><h2>{labels.experience}</h2><div class="cv-experience">{content.experience.map((item) => <article><time>{item.date}</time><div><h3>{item.company} · {item.role}</h3><p>{item.description}</p></div></article>)}</div></section>
  <section class="cv-section"><h2>{labels.projects}</h2><div class="cv-cases">{content.cases.map((item) => <article><h3>{item.title}</h3><p>{item.summary}</p><p><strong>{labels.responsibility}:</strong> {item.responsibility}</p><p class="limit"><strong>{labels.limits}:</strong> {item.limits}</p></article>)}</div></section>
  <section class="cv-section cv-compact"><h2>{labels.capabilities}</h2><div>{content.capabilities.map((item) => <article><h3>{item.title}</h3><p>{item.evidence}</p></article>)}</div></section>
  <section class="cv-section cv-compact"><h2>{labels.secondary}</h2><div>{content.secondary.map((item) => <article><h3>{item.title} · {item.status}</h3><p>{item.responsibility}</p></article>)}</div></section>
  <p class="cv-end">{locale === 'es' ? 'Contenido actualizado: agosto de 2026.' : 'Content updated: August 2026.'}</p>
</main>
