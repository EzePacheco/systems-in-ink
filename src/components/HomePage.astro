---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile/ezequiel-pacheco.png';
import { casePath, cvPath, socialLinks, type PortfolioContent } from '../data/portfolio.data';
import SiteHeader from './SiteHeader.astro';

type Props = { content: PortfolioContent };
const { content } = Astro.props;
const { locale, profile, labels } = content;
const sectionIds = locale === 'es'
  ? { projects: 'proyectos', experience: 'experiencia', secondary: 'trabajo-secundario', capabilities: 'capacidades', contact: 'contacto' }
  : { projects: 'projects', experience: 'experience', secondary: 'additional-work', capabilities: 'capabilities', contact: 'contact' };
---

<a class="skip-link" href="#main">{labels.skip}</a>
<SiteHeader locale={locale} nav={content.nav} alternatePath={locale === 'es' ? '/en/' : '/'} languageLabel={labels.language} cvLabel={labels.printableCv} navLabel={labels.nav} />
<main id="main">
  <section class="hero page-width">
    <div class="hero-copy">
      <p class="kicker">{profile.role}</p>
      <h1>Ezequiel<br />Pacheco</h1>
      <p class="hero-lede">{profile.hero}</p>
      <p class="availability">{profile.location} · {profile.currentCompany}<br />{profile.availability}</p>
      <div class="actions">
        <a class="button primary" href={`mailto:${profile.email}`}>{labels.contact}</a>
        <a class="button" href={cvPath(locale)}>{labels.printableCv}</a>
        <a class="text-action" href={`#${sectionIds.projects}`}>{labels.projects} ↓</a>
      </div>
    </div>
    <figure class="portrait">
      <Image src={profilePhoto} alt={locale === 'es' ? 'Retrato de Ezequiel Pacheco' : 'Portrait of Ezequiel Pacheco'} width={430} height={570} loading="eager" />
    </figure>
  </section>

  <section id={sectionIds.projects} class="section page-width">
    <header class="section-heading"><p class="kicker">01 · {labels.projects}</p><h2>{locale === 'es' ? 'Decisiones, responsabilidad y evidencia.' : 'Decisions, ownership and evidence.'}</h2></header>
    <div class="case-index">
      {content.cases.map((item, index) => (
        <article class="case-preview">
          <a href={casePath(locale, item.slug)} aria-label={`${labels.viewCase}: ${item.title}`}>
            <figure><img src={item.media[0].src} alt={item.media[0].alt} loading={index === 0 ? 'eager' : 'lazy'} /></figure>
            <div class="case-preview-copy"><p class="case-meta">0{index + 1} · {item.status}</p><h3>{item.title}</h3><p>{item.summary}</p><span>{labels.viewCase} →</span></div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id={sectionIds.experience} class="section page-width ruled-section">
    <header class="section-heading"><p class="kicker">02 · {labels.experience}</p><h2>{locale === 'es' ? 'Construir también es entender la operación.' : 'Building also means understanding operations.'}</h2></header>
    <div class="timeline">
      {content.experience.map((item) => <article><time>{item.date}</time><div><h3>{item.company}</h3><p class="role">{item.role}</p></div><p>{item.description}</p></article>)}
    </div>
  </section>

  <section id={sectionIds.secondary} class="section ink-section">
    <div class="page-width">
      <header class="section-heading"><p class="kicker">03 · {labels.secondary}</p><h2>{locale === 'es' ? 'Alcance claro, estado explícito.' : 'Clear scope, explicit status.'}</h2></header>
      <div class="secondary-grid">
        {content.secondary.map((item) => <article><p class="case-meta">{item.status}</p><h3>{item.title}</h3><p>{item.summary}</p><dl><dt>{labels.responsibility}</dt><dd>{item.responsibility}</dd><dt>{labels.limits}</dt><dd>{item.limits}</dd></dl></article>)}
      </div>
    </div>
  </section>

  <section id={sectionIds.capabilities} class="section page-width">
    <header class="section-heading"><p class="kicker">04 · {labels.capabilities}</p><h2>{locale === 'es' ? 'Capacidades conectadas a trabajo real.' : 'Capabilities connected to real work.'}</h2></header>
    <div class="capability-grid">{content.capabilities.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p><strong>{item.evidence}</strong></article>)}</div>
    <article class="systems-card"><p class="kicker">{labels.systems}</p><h3>{content.engineeringSystems.title}</h3><p>{content.engineeringSystems.summary}</p><ul>{content.engineeringSystems.evidence.map((item) => <li>{item}</li>)}</ul><p class="limit">{content.engineeringSystems.limits}</p></article>
  </section>

  <section id={sectionIds.contact} class="contact-section">
    <div class="page-width"><p class="kicker">05 · {labels.contact}</p><h2>{locale === 'es' ? '¿Construimos algo que merezca existir?' : 'Shall we build something worth existing?'}</h2><div class="contact-links"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={socialLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub ↗</a></div></div>
  </section>
</main>
<footer class="footer page-width"><span>© 2026 {profile.name}</span><span>{profile.role}</span></footer>
