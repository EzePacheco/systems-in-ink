---
import { homePath, type CaseStudy, type PortfolioContent } from '../data/portfolio.data';
import SiteHeader from './SiteHeader.astro';

type Props = { content: PortfolioContent; project: CaseStudy; alternatePath: string };
const { content, project, alternatePath } = Astro.props;
const { locale, labels } = content;
const facts = [
  [labels.problem, project.problem],
  [labels.context, project.context],
  [labels.responsibility, project.responsibility],
];
---

<a class="skip-link" href="#main">{labels.skip}</a>
<SiteHeader locale={locale} nav={[]} alternatePath={alternatePath} languageLabel={labels.language} cvLabel={labels.printableCv} navLabel={labels.nav} />
<main id="main" class="case-page">
  <header class="case-hero page-width">
    <a class="back-link" href={homePath(locale)}>← {labels.back}</a>
    <p class="kicker">{project.status}</p>
    <h1>{project.title}</h1>
    <p>{project.summary}</p>
  </header>
  <section class="case-facts page-width">{facts.map(([label, value]) => <article><h2>{label}</h2><p>{value}</p></article>)}</section>
  <section class="case-media page-width" aria-label={labels.evidence}>
    {project.media.map((media) => (
      <figure class:list={{ 'media-mobile': media.assetId === 'chichitosMobile' }}>
        {media.kind === 'video' ? (
          <video controls preload="metadata" aria-label={media.alt}><source src={media.src} type="video/mp4" /></video>
        ) : (
          <img src={media.src} alt={media.alt} loading="lazy" />
        )}
        <figcaption>{media.caption}</figcaption>
      </figure>
    ))}
  </section>
  <div class="case-detail page-width">
    <section><h2>{labels.decisions}</h2><ol>{project.decisions.map((item) => <li>{item}</li>)}</ol></section>
    <section><h2>{labels.implementation}</h2><ul>{project.implementation.map((item) => <li>{item}</li>)}</ul></section>
    <section><h2>{labels.evidence}</h2><ul>{project.evidence.map((item) => <li>{item}</li>)}</ul></section>
    <section class="limits"><h2>{labels.limits}</h2><p>{project.limits}</p></section>
  </div>
  <footer class="case-cta page-width">{project.links.map((link) => <a class="button primary" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}{link.external ? ' ↗' : ' →'}</a>)}</footer>
</main>
