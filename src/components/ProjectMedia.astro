---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Aspect = "landscape" | "wide" | "portrait" | "mobile" | "collage" | "tooling";
type Fit = "cover" | "contain";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  aspect?: Aspect;
  fit?: Fit;
  position?: string;
  caption?: string;
  placeholder?: string;
  class?: string;
  priority?: boolean;
}

const {
  src,
  alt = "",
  aspect = "landscape",
  fit = "contain",
  position = "center",
  caption,
  placeholder,
  class: className,
  priority = false,
} = Astro.props;
---

<figure
  class:list={["project-media", `project-media--${aspect}`, `project-media--${fit}`, className]}
  style={`--media-position: ${position}`}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        widths={[640, 960, 1440]}
        sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 1000px) 92vw, 58vw"
        loading={priority ? "eager" : "lazy"}
        decoding="async"
      />
    ) : (
      <div class="project-media__placeholder" aria-label={placeholder}>
        <span>{placeholder}</span>
        <small>Nueva captura pendiente</small>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
