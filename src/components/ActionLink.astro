---
interface Props {
  href: string;
  label: string;
  variant?: "outline" | "dark" | "text";
  external?: boolean;
  download?: boolean;
  standalone?: boolean;
  ariaLabel?: string;
  title?: string;
}
const { href, label, variant = "outline", external = false, download = false, standalone = false, ariaLabel, title } = Astro.props;
const variants = {
  outline: "project-link",
  dark: "header-cv",
  text: "action-link--text",
};
const email = href.startsWith("mailto:");
const icon = email ? "email" : download ? "download" : href.startsWith("#") ? "down" : "external";
---

<a class:list={["action-link", variants[variant], { inline: standalone }]} href={href} download={download || undefined} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} aria-label={ariaLabel ?? (external && !email ? `${label} (abre en otra pestaña)` : undefined)} title={title}>
  <span class="action-link__label project-link__label">{label}</span>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {icon === "email" ? <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></> : icon === "download" ? <><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></> : icon === "down" ? <path d="M12 4v16m-6-6 6 6 6-6" /> : <><path d="M14 3h7v7m0-7L10 14" /><path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" /></>}
  </svg>
</a>
