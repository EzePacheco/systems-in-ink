---
import { navItems, profile } from "../../data/portfolio.data";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import PortfolioStyles from "./PortfolioStyles.astro";
---

<PortfolioStyles />
<div class="page-shell">
  <Header links={navItems} cvPath={profile.cvPath} />
  <main id="inicio">
    <slot />
  </main>
  <Footer name={profile.name} note={profile.footerNote} />
</div>
