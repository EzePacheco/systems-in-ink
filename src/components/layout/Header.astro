---
import type { LinkItem } from "../../data/portfolio.data";

interface Props {
  links: LinkItem[];
  cvPath: string;
}

const { links, cvPath } = Astro.props;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Navegación principal">
    {
      links.map((link) => (
        <a href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <a class="mobile-cv" href={cvPath} download>
    CV
    <span aria-hidden="true">↓</span>
  </a>
</header>
