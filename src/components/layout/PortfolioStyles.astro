<style is:global>
  html:root {
    scroll-behavior: auto;
  }

  body {
    color: #15130f;
    background: #e6dece;
    font-family: "Manrope Variable", "Manrope", ui-sans-serif, system-ui, sans-serif;
  }

  body .page-shell {
    container-type: inline-size;
    width: min(100%, 1440px);
    padding: 0;
    background: #f1ecdf;
  }

  main > section[id],
  .featured-case {
    scroll-margin-top: 76px;
  }

  .site-header {
    position: fixed;
    top: 16px;
    left: 50%;
    z-index: 40;
    width: max-content;
    padding: 4px;
    border: 1px solid rgba(242, 239, 230, 0.22);
    border-radius: 999px;
    background: rgba(20, 18, 15, 0.72);
    box-shadow: 0 12px 36px rgba(3, 3, 3, 0.18);
    backdrop-filter: blur(20px) saturate(1.15);
    transform: translateX(-50%);
    transition:
      top 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .site-header.is-scrolled {
    top: 10px;
    background: rgba(20, 18, 15, 0.86);
    box-shadow: 0 14px 40px rgba(3, 3, 3, 0.24);
    transform: translateX(-50%) scale(0.97);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 550;
    text-transform: uppercase;
    letter-spacing: 0.045em;
    color: #f2efe6;
  }

  .site-nav a {
    position: relative;
    padding: 8px 12px;
    border-radius: 999px;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: #171510;
    background: #ffdb89;
  }

  .mobile-cv {
    display: none;
  }

  .page-shell .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.55fr);
    min-height: 100svh;
    overflow: hidden;
    color: #f2efe6;
    background:
      radial-gradient(circle at 80% 10%, rgba(255, 219, 137, 0.13), transparent 31rem),
      linear-gradient(135deg, #171510, #0d0c0a 72%);
  }

  .page-shell .hero::after {
    display: none;
  }

  .page-shell .hero-main {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(64px, 9cqw, 128px) clamp(20px, 6cqw, 84px);
    border-right: 0;
  }

  .page-shell .hero-main::before {
    display: none;
  }

  .hero-kicker,
  .section-kicker {
    color: #ffdb89;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hero-identity {
    display: flex;
    gap: clamp(24px, 3cqw, 42px);
    align-items: center;
    margin-top: 24px;
  }

  .hero h1 {
    max-width: 9ch;
    font-family: var(--font-serif);
    font-size: clamp(4.2rem, 8.5cqw, 8.2rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.78;
  }

  .hero h1 span {
    display: block;
  }

  .hero h1 span:last-child {
    color: #ffdb89;
    font-style: normal;
    font-weight: 650;
  }

  .page-shell .hero-copy {
    max-width: 760px;
    margin-top: 34px;
    color: rgba(242, 239, 230, 0.78);
    font-size: clamp(1.05rem, 1.55cqw, 1.35rem);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 24px;
    color: rgba(242, 239, 230, 0.56);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .hero-meta span::before {
    content: "•";
    margin-right: 8px;
    color: #aa3027;
  }

  .page-shell .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 38px;
  }

  .page-shell .btn {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 18px;
    border: 1px solid rgba(242, 239, 230, 0.38);
    color: #f2efe6;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .page-shell .btn-primary {
    border-color: #ffdb89;
    color: #030303;
    background: #ffdb89;
  }

  .page-shell .btn-text {
    border-color: transparent;
    color: #ffdb89;
  }

  .hero-proof {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 6cqw, 84px);
    border-left: 1px solid rgba(242, 239, 230, 0.18);
  }

  .hero-person {
    position: relative;
    display: grid;
    width: 196px;
    height: 196px;
    flex: 0 0 auto;
    place-items: center;
    margin: 0 clamp(40px, 6cqw, 90px) 0 auto;
    animation: hero-portrait-float 5s ease-in-out infinite;
    will-change: transform;
  }

  .hero-person::before,
  .hero-person::after {
    position: absolute;
    content: "";
    border: 1px solid rgba(255, 219, 137, 0.26);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-person::before {
    inset: 0;
    border-right-color: transparent;
    animation: hero-portrait-orbit 16s linear infinite;
  }

  .hero-person::after {
    inset: 13px;
    border-color: rgba(242, 239, 230, 0.12);
  }

  .hero-person img {
    width: 168px;
    height: 168px;
    display: block;
    border-radius: 50%;
    filter: grayscale(1) contrast(1.04);
    mask-image: radial-gradient(circle, #000 58%, rgba(0, 0, 0, 0.9) 68%, transparent 78%);
    object-fit: cover;
    object-position: 50% 26%;
    opacity: 0.94;
  }

  @keyframes hero-portrait-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-9px);
    }
  }

  @keyframes hero-portrait-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-proof-item {
    display: grid;
    gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid rgba(242, 239, 230, 0.18);
  }

  .hero-proof-item:first-child {
    border-top: 1px solid rgba(242, 239, 230, 0.18);
  }

  .hero-proof-item strong {
    color: #ffdb89;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.2cqw, 2rem);
    font-weight: 600;
  }

  .hero-proof-item span {
    color: rgba(242, 239, 230, 0.58);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 48px minmax(280px, 0.9fr) minmax(260px, 0.55fr);
    gap: clamp(20px, 4cqw, 56px);
    align-items: end;
    padding: clamp(38px, 4cqw, 56px) clamp(20px, 6cqw, 84px);
    border-bottom: 1px solid rgba(21, 19, 15, 0.22);
  }

  .section-num,
  .job-index {
    color: #b27c22;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .section-intro .section-kicker {
    margin-bottom: 14px;
    color: #aa3027;
  }

  .section-intro h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5.8cqw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .section-intro > p {
    color: #70695e;
  }

  body .experience {
    color: #15130f;
    background: #f1ecdf;
  }

  .experience-list {
    padding: 0 clamp(20px, 6cqw, 84px) clamp(56px, 8cqw, 104px);
  }

  .experience .job {
    display: grid;
    grid-template-columns: 48px minmax(220px, 0.72fr) minmax(260px, 1fr) 170px;
    gap: clamp(20px, 4cqw, 56px);
    padding: 30px 0;
    border-bottom: 1px solid rgba(21, 19, 15, 0.22);
  }

  .experience .job-index {
    grid-column: 1;
  }

  .experience .job-heading {
    grid-column: 2;
  }

  .experience .job-description {
    grid-column: 3;
  }

  .experience .job time {
    grid-column: 4;
  }

  .job-heading h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 2.8cqw, 2.7rem);
    line-height: 1;
  }

  .job-role {
    margin-top: 8px;
    color: #aa3027;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .job-description,
  .job time {
    color: #70695e;
    font-size: 0.92rem;
  }

  .job time {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    text-align: right;
  }

  body .case-studies {
    color: #f2efe6;
    background: #030303;
  }

  .section-intro-dark {
    border-bottom-color: rgba(242, 239, 230, 0.2);
  }

  .section-intro-dark .section-num,
  .section-intro-dark .section-kicker {
    color: #ffdb89;
  }

  .section-intro-dark > p {
    color: rgba(242, 239, 230, 0.58);
  }

  .featured-case {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    border-bottom: 1px solid rgba(242, 239, 230, 0.2);
  }

  .featured-case:nth-child(even) .case-media {
    order: 2;
    border-right: 0;
    border-left: 1px solid rgba(242, 239, 230, 0.2);
  }

  .featured-case:nth-child(even) .case-copy {
    order: 1;
  }

  .page-shell .case-media {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border-right: 1px solid rgba(242, 239, 230, 0.2);
    background: #090806;
  }

  .page-shell .case-media img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: contain;
  }

  .page-shell .case-media figcaption {
    min-height: 42px;
    padding: 11px 16px;
    border-top: 1px solid rgba(242, 239, 230, 0.2);
    color: rgba(242, 239, 230, 0.42);
    font-family: var(--font-mono);
    font-size: 0.63rem;
  }

  .page-shell .case-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(38px, 5.5cqw, 76px);
  }

  .page-shell .case-kicker {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
    color: #ffdb89;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  .page-shell .case-kicker span + span {
    padding-left: 10px;
    border-left: 1px solid rgba(255, 219, 137, 0.32);
  }

  .page-shell .case-header h3 {
    font-family: var(--font-serif);
    font-size: clamp(3.3rem, 6cqw, 6rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  .page-shell .case-header > p {
    margin-top: 22px;
    color: rgba(242, 239, 230, 0.72);
  }

  .case-facts {
    display: grid;
    gap: 18px;
    margin-top: 30px;
  }

  .case-facts > div {
    padding-top: 15px;
    border-top: 1px solid rgba(242, 239, 230, 0.2);
  }

  .case-facts dt {
    color: #ffdb89;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .case-facts dd {
    margin-top: 7px;
    color: rgba(242, 239, 230, 0.58);
    font-size: 0.88rem;
  }

  .evidence-list,
  .tag-list,
  .compact-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-list {
    margin-top: 24px;
  }

  .evidence-list li {
    padding: 6px 9px;
    border: 1px solid rgba(255, 219, 137, 0.22);
    color: rgba(242, 239, 230, 0.72);
    font-size: 0.7rem;
  }

  .case-details {
    margin-top: 24px;
    border-top: 1px solid rgba(242, 239, 230, 0.2);
    border-bottom: 1px solid rgba(242, 239, 230, 0.2);
  }

  .case-details summary {
    min-height: 46px;
    display: flex;
    cursor: pointer;
    align-items: center;
    justify-content: space-between;
    color: #ffdb89;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    list-style: none;
  }

  .case-details summary::after {
    content: "+";
  }

  .case-details[open] summary::after {
    content: "−";
  }

  .case-details > ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 0;
    padding-bottom: 20px;
    list-style: none;
  }

  .case-details > ul li {
    color: rgba(242, 239, 230, 0.62);
    font-size: 0.84rem;
  }

  .case-footer {
    display: grid;
    gap: 18px;
    margin-top: 24px;
  }

  .tag-list,
  .compact-stack {
    gap: 6px 14px;
    color: rgba(242, 239, 230, 0.4);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .text-link {
    display: inline-flex;
    width: fit-content;
    gap: 8px;
    border-bottom: 1px solid #ffdb89;
    color: #ffdb89;
    font-size: 0.76rem;
    font-weight: 800;
  }

  body .other-work {
    padding: clamp(60px, 8cqw, 108px) clamp(20px, 6cqw, 84px);
    background: #1b1914;
  }

  .other-work-heading {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(300px, 1fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 36px;
  }

  .other-work-heading h3 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4.4cqw, 4.5rem);
    font-weight: 600;
    line-height: 0.98;
  }

  .other-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(242, 239, 230, 0.2);
    border-left: 1px solid rgba(242, 239, 230, 0.2);
  }

  .compact-project {
    border-right: 1px solid rgba(242, 239, 230, 0.2);
    border-bottom: 1px solid rgba(242, 239, 230, 0.2);
  }

  .compact-project figure {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid rgba(242, 239, 230, 0.2);
  }

  .compact-project figure img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background: #090806;
  }

  .compact-project-copy {
    padding: clamp(22px, 3cqw, 34px);
  }

  .compact-project h4 {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 3.3cqw, 3.3rem);
    font-weight: 600;
    line-height: 0.95;
  }

  .compact-project-copy > p {
    min-height: 6.8em;
    margin-top: 17px;
    color: rgba(242, 239, 230, 0.58);
    font-size: 0.86rem;
  }

  .compact-stack,
  .compact-links {
    margin-top: 18px;
  }

  .compact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .compact-details > p {
    padding-bottom: 12px;
    color: rgba(242, 239, 230, 0.62);
    font-size: 0.8rem;
  }

  body .capabilities {
    color: #15130f;
    background: #faf7f0;
  }

  .capability-grid {
    padding: 0 clamp(20px, 6cqw, 84px) clamp(64px, 9cqw, 116px);
  }

  .capability {
    border-top: 1px solid rgba(21, 19, 15, 0.22);
    border-bottom: 1px solid rgba(21, 19, 15, 0.22);
  }

  .capability + .capability {
    border-top: 0;
  }

  .capability summary {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: clamp(20px, 4cqw, 56px);
    align-items: center;
    padding: clamp(28px, 3.6cqw, 48px) 0;
    cursor: pointer;
    list-style: none;
  }

  .capability summary::-webkit-details-marker {
    display: none;
  }

  .capability summary::after {
    content: "+";
    color: #aa3027;
    font-size: clamp(1.8rem, 3cqw, 3rem);
    font-weight: 400;
    line-height: 1;
    transition: transform 240ms ease;
  }

  .capability[open] summary::after {
    transform: rotate(45deg);
  }

  .capability summary > span {
    color: #aa3027;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .capability h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.8cqw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
    transition:
      color 180ms ease,
      transform 240ms ease;
  }

  .capability summary:hover h3,
  .capability summary:focus-visible h3,
  .capability[open] h3 {
    color: #aa3027;
    transform: translateX(8px);
  }

  .capability-body {
    display: grid;
    grid-template-columns: 48px minmax(240px, 0.8fr) minmax(280px, 1fr);
    gap: clamp(20px, 4cqw, 56px);
    padding: 0 0 clamp(32px, 4cqw, 52px);
  }

  .capability-body p {
    grid-column: 2;
    margin: 0;
    color: #70695e;
    font-size: 0.96rem;
  }

  .capability-body ul {
    grid-column: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability-body li {
    padding: 5px 8px;
    border: 1px solid rgba(21, 19, 15, 0.22);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  body .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    color: #f2efe6;
    background: #030303;
  }

  .page-shell .contact-copy {
    padding: clamp(64px, 9cqw, 120px) clamp(20px, 6cqw, 84px);
    border-right: 1px solid rgba(242, 239, 230, 0.2);
  }

  .page-shell .contact-copy h2 {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6.8cqw, 6.6rem);
    font-weight: 600;
    line-height: 0.9;
    text-wrap: balance;
  }

  .page-shell .contact-copy > p:not(.section-kicker) {
    margin-top: 26px;
    color: rgba(242, 239, 230, 0.62);
  }

  .contact-cta {
    margin-top: 34px;
  }

  .page-shell .contact-links {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(30px, 5cqw, 70px);
  }

  .page-shell .contact-links a {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    min-height: 72px;
    border-bottom: 1px solid rgba(242, 239, 230, 0.2);
  }

  .page-shell .contact-links strong {
    min-width: 0;
    overflow: hidden;
    font-size: 0.78rem;
    text-overflow: ellipsis;
  }

  .footer {
    color: rgba(242, 239, 230, 0.44);
    background: #030303;
  }

  @media (max-width: 1080px) {
    .page-shell .hero,
    .featured-case,
    body .contact {
      grid-template-columns: 1fr;
    }

    .page-shell .hero-main {
      min-height: 620px;
      border-right: 0;
    }

    .hero-proof {
      padding: 0 clamp(20px, 6cqw, 84px) 64px;
      border-left: 0;
    }

    .section-intro {
      grid-template-columns: 42px minmax(0, 1fr);
    }

    .section-intro > p {
      grid-column: 2;
    }

    .experience .job {
      grid-template-columns: 42px minmax(210px, 0.75fr) minmax(260px, 1fr);
    }

    .experience .job time {
      grid-column: 2;
      text-align: left;
    }

    .featured-case:nth-child(even) .case-media,
    .featured-case:nth-child(even) .case-copy {
      order: initial;
    }

    .featured-case:nth-child(even) .case-media,
    .page-shell .case-media {
      border-right: 0;
      border-left: 0;
    }

    .page-shell .case-media img {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .other-projects {
      grid-template-columns: 1fr 1fr;
    }

    .compact-project-copy > p {
      min-height: auto;
    }
  }

  @media (max-width: 720px) {
    main > section[id],
    .featured-case {
      scroll-margin-top: 72px;
    }

    .site-header {
      top: auto;
      right: 18px;
      bottom: 18px;
      left: auto;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      transform: none;
    }

    .site-header.is-scrolled {
      top: auto;
      background: transparent;
      box-shadow: none;
      transform: none;
    }

    .site-nav {
      display: none;
    }

    .mobile-cv {
      display: inline-flex;
      min-width: 74px;
      min-height: 46px;
      align-items: center;
