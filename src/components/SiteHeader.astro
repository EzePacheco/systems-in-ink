---
import { cvPath, homePath, type Locale, type LinkItem } from '../data/portfolio.data';

type Props = {
  locale: Locale;
  nav: LinkItem[];
  alternatePath: string;
  languageLabel: string;
  cvLabel: string;
  navLabel: string;
};

const { locale, nav, alternatePath, languageLabel, cvLabel, navLabel } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href={homePath(locale)} aria-label="Ezequiel Pacheco, home">EP</a>
  <nav aria-label={navLabel}>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    <a href={alternatePath} hreflang={locale === 'es' ? 'en' : 'es'}>{languageLabel}</a>
    <a class="header-cv" href={cvPath(locale)}>{cvLabel}</a>
  </div>
</header>
