---
import { projects } from "../../data/portfolio.data";
import CaseStudy from "./CaseStudy.astro";
import OtherProjects from "./OtherProjects.astro";

const featuredProjects = projects.filter((project) => project.prominence === "featured");
const compactProjects = projects.filter((project) => project.prominence === "compact");
---

<section id="proyectos" class="case-studies" aria-labelledby="proyectos-title">
  <div class="section-intro section-intro-dark" data-enter>
    <span class="section-num" aria-hidden="true">02</span>
    <div>
      <p class="section-kicker">Trabajo seleccionado</p>
      <h2 id="proyectos-title">Sistemas, decisiones y evidencia.</h2>
    </div>
    <p>
      Dos casos profesionales en profundidad y otros proyectos que muestran amplitud técnica,
      producto propio y trabajo público.
    </p>
  </div>

  <div class="featured-projects">
    {featuredProjects.map((project) => <CaseStudy project={project} />)}
  </div>

  <OtherProjects projects={compactProjects} />
</section>
