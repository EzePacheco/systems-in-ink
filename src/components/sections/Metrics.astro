---
import { metrics } from "../../data/portfolio.data";
---

<section class="metrics" aria-label="Métricas de impacto">
  {
    metrics.map((metric) => (
      <article class="metric">
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
        <small>{metric.context}</small>
      </article>
    ))
  }
</section>
