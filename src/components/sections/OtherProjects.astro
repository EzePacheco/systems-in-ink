---
import { Image } from "astro:assets";
import type { Project } from "../../data/portfolio.data";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="other-work" aria-labelledby="other-work-title">
  <div class="other-work-heading" data-enter>
    <p class="section-kicker">Más trabajo</p>
    <h3 id="other-work-title">Otros productos que completan el recorrido.</h3>
  </div>

  <div class="other-projects">
    {
      projects.map((project) => (
        <article class="compact-project" data-enter>
          {project.media?.src && (
            <figure>
              <Image
                src={project.media.src}
                alt={project.media.alt}
                widths={[480, 720]}
                sizes="(max-width: 720px) 100vw, (max-width: 1080px) 50vw, 720px"
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}

          <div class="compact-project-copy">
            <div class="case-kicker">
              <span>{project.index}</span>
              <span>{project.status}</span>
            </div>
            <h4>{project.title}</h4>
            <p>{project.summary}</p>

            <ul class="compact-stack" aria-label={`Tecnologías de ${project.title}`}>
              {project.stack.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>

            <div class="compact-links">
              {project.links.map((link) => (
                <a
                  class="text-link"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                >
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>

            <details class="case-details compact-details">
              <summary>Ver detalle técnico</summary>
              <p><strong>Mi responsabilidad:</strong> {project.responsibility}</p>
              <ul>
                {project.decisions.map((decision) => <li>{decision}</li>)}
              </ul>
            </details>
          </div>
        </article>
      ))
    }
  </div>
</div>
