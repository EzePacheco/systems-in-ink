---
import { Image } from "astro:assets";
import profilePhoto from "../../assets/profile/ezequiel-pacheco.png";
import { heroActions, profile, recruiterProof } from "../../data/portfolio.data";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-main">
    <p class="hero-kicker">{profile.role}</p>
    <div class="hero-identity">
      <h1 id="hero-title">
        <span>Ezequiel</span>
        <span>Pacheco</span>
      </h1>
      <figure class="hero-person">
        <Image
          src={profilePhoto}
          alt="Retrato de Ezequiel Pacheco"
          width={168}
          height={168}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
    <p class="hero-copy">{profile.heroDescription}</p>

    <div class="hero-meta" aria-label="Información profesional">
      <span>{profile.location}</span>
      <span>Actualmente en {profile.currentCompany}</span>
    </div>

    <div class="actions" aria-label="Acciones principales">
      {
        heroActions.map((action, index) => (
          <a
            class:list={[
              "btn",
              {
                "btn-primary": index === 0,
                "btn-text": index === 2,
                "hero-cv": action.download,
              },
            ]}
            href={action.href}
            target={action.external ? "_blank" : undefined}
            rel={action.external ? "noreferrer" : undefined}
            download={action.download ? true : undefined}
          >
            {action.label}
            <span aria-hidden="true">{action.download || index === 2 ? "↓" : "↗"}</span>
          </a>
        ))
      }
    </div>
  </div>

  <aside class="hero-proof" aria-label="Resumen profesional">
    {
      recruiterProof.map((item) => (
        <div class="hero-proof-item">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))
    }
  </aside>
</section>
