---
import { stackGroups } from "../../data/portfolio.data";
---

<section id="stack" aria-labelledby="stack-title">
  <div class="section-grid">
    <div class="section-title">
      <span class="section-num" aria-hidden="true">03 / 道具</span>
      <h2 id="stack-title">Stack técnico</h2>
      <p>Tecnologías agrupadas por responsabilidad, no como nube de logos.</p>
    </div>

    <div class="section-body stack-grid">
      {
        stackGroups.map((group) => (
          <article class="stack-col">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
              <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
