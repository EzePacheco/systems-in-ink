---
import { experience } from "../../data/portfolio.data";
---

<section id="experiencia" aria-labelledby="experiencia-title">
  <div class="section-grid">
    <div class="section-title">
      <span class="section-num" aria-hidden="true">04 / 経歴</span>
      <h2 id="experiencia-title">Experiencia</h2>
      <p>Una trayectoria combinando desarrollo, operación y control de calidad.</p>
    </div>

    <div class="section-body experience-list">
      {
        experience.map((item) => (
          <article class="job">
            <span class="job-date">{item.date}</span>
            <div>
              <h3>{item.company}</h3>
              <span class="job-role">{item.role}</span>
              <p>{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
