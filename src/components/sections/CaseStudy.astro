---
import { Image } from "astro:assets";
import type { Project } from "../../data/portfolio.data";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article id={`caso-${project.id}`} class="featured-case" data-enter>
  <figure class="case-media">
    {project.media.src ? (
      <Image
        src={project.media.src}
        alt={project.media.alt}
        widths={[640, 960, 1440]}
        sizes="(max-width: 1080px) 100vw, min(54vw, 778px)"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="case-media-placeholder">{project.title} · nueva captura pendiente</div>
    )}
    {project.media.caption && <figcaption>{project.media.caption}</figcaption>}
  </figure>

  <div class="case-copy">
    <header class="case-header">
      <div class="case-kicker">
        <span>{project.index}</span>
        <span>{project.status}</span>
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
    </header>

    <dl class="case-facts">
      <div>
        <dt>Problema</dt>
        <dd>{project.problem}</dd>
      </div>
      <div>
        <dt>Mi responsabilidad</dt>
        <dd>{project.responsibility}</dd>
      </div>
    </dl>

    <ul class="evidence-list" aria-label={`Evidencia de ${project.title}`}>
      {project.evidence.map((item) => <li>{item}</li>)}
    </ul>

    <details class="case-details">
      <summary>Ver decisiones técnicas</summary>
      <ul>
        {project.decisions.map((decision) => <li>{decision}</li>)}
      </ul>
    </details>

    <div class="case-footer">
      <ul class="tag-list" aria-label={`Tecnologías de ${project.title}`}>
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>
      {
        project.links.map((link) => (
          <a
            class="text-link"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</article>
